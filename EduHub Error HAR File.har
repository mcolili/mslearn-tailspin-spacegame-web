h equation answer\", //i18next.t(\"common_richtext_insert_equation\"),\r\n                        onAction: function () {\r\n                            window.Utils.resetImageStatus();\r\n\r\n                            var ids = window.Utils.getMEEIds();\r\n                            var qnId = $(\"#txtQuestion\").attr(\"questionid\");\r\n                            popupCenter({ url: \"/Lead/MEE/insert_htmlequation.aspx?from=questionbank&resid=\" + qnId + \"&id=\" + ids + \"&ans=1\", title: 'insert_equation', w: 800, h: 500 });\r\n                        },\r\n                    });\r\n                }\r\n\r\n                // HTML MATH EDITOR\r\n                editor.on('beforesetcontent', function (ed) {\r\n                    //if (o.content.length > 0) {\r\n                    //    ed.setProgressState(true);\r\n                    //    var editor = ed.getBody();\r\n                    //    editor.style.visibility = \"\";\r\n\r\n                    //    o.content = replaceMathJax2MathMl(ed, o);\r\n                    //}\r\n                });\r\n\r\n                editor.on('getcontent', function (ed) {\r\n                    //var contents = tinyMCE.activeEditor.getBody().innerHTML;\r\n                    //// If MathML equation detected, load the equation with MathJax.\r\n                    //if (contents.indexOf('<math') >= 0) {\r\n                    //    contents = window.Utils.convertMathJax2MathMl(tinyMCE.activeEditor.getBody().innerHTML);\r\n                    //}\r\n                    //tinyMCE.activeEditor.getBody().innerHTML = contents;\r\n                });\r\n\r\n                editor.on('keyup', function (e) {\r\n                    //startEquation = editor.dom.getParent(editor.selection.getNode(), '.mce_equation');\r\n                    //if (startEquation)\r\n                    //    fixMathJaxEquationSelection(editor);\r\n                    //window.Utils.cleanup(startEquation);\r\n                });\r\n\r\n                editor.on('keydown', function (e) {\r\n                    // Always remove the previous start equation.\r\n                    if (startEquation)\r\n                        startEquation.classList.remove(\"mce_equation-selected\");\r\n                    startEquation = editor.dom.getParent(e.target, '.mce_equation');\r\n                    fixEqnCaretPos(editor);\r\n                    fixMathJaxEquationSelection(editor);\r\n                });\r\n\r\n                editor.on('mouseup', function (e) {\r\n                    if (e.button !== 2) {\r\n                        // Always remove the previous start equation.\r\n                        if (startEquation)\r\n                            startEquation.classList.remove(\"mce_equation-selected\");\r\n\r\n                        var selectedTarget = e.target;\r\n                        if (e.target.tagName === \"BODY\" || e.target.tagName === \"HTML\") {\r\n                            selectedTarget = editor.selection.getNode();\r\n                        }\r\n                        startEquation = editor.dom.getParent(selectedTarget, '.mce_equation');\r\n\r\n                        // TODO: Show selection if selection is a range.\r\n                        /*for (var i=0; i < selectedTarget.getElementsByClassName(\"mce_equation\").length;i++){\r\n                            selectedTarget.getElementsByClassName(\"mce_equation\")[i].classList.add(\"mce_equation-selected\");\r\n                        }*/\r\n                        if (startEquation) {\r\n                            fixEqnCaretPos(editor);\r\n                            fixMathJaxEquationSelection(editor);\r\n                        }\r\n                        else {\r\n                            // Check if MathJax and Not Math Equation (like Chem Equation)\r\n                            var isMathJaxEqn = editor.dom.getParent(selectedTarget, '.MathJax');\r\n                            if (isMathJaxEqn) {\r\n                                alert(\"This equation is not supported for editing.\");\r\n                            }\r\n\r\n                        }\r\n                    }\r\n                });\r\n\r\n                editor.on('init', function (e) {\r\n                    // Math Editor\r\n                    var dom = editor.dom;\r\n                    // Might be selected equation on reload\r\n                    var hasEquationSelection = true;\r\n\r\n                    dom.bind(editor.getDoc(), 'mouseover', function (e) {\r\n                        var sel, equation, target = e.target;\r\n\r\n                        if (startEquation) {\r\n                            equation = dom.getParent(target, '.mce_equation');\r\n                            if (equation === startEquation) {\r\n                                hasEquationSelection = true;\r\n                            }\r\n                            e.preventDefault();\r\n                        }\r\n                    });\r\n                });\r\n\r\n                /*   editor.on('Change', function (e) {\r\n                       if (options.changeCallback) {\r\n                           options.changeCallback();\r\n                       }\r\n                   });*/\r\n            }\r\n        }));\r\n    },\r\n/*    imageUpload:    function (e) {\r\n    alert(e);\r\n    },*/\r\n    destroyTextEditor: async function (target) {\r\n        // Ensure TinyMCE is loaded before trying to destroy\r\n        if (typeof tinymce === 'undefined') {\r\n            console.warn('[destroyTextEditor] TinyMCE not loaded, nothing to destroy');\r\n            return;\r\n        }\r\n\r\n        var editor = tinymce.get(target.id);\r\n        if (!editor) return;\r\n        if (editor.isDirty()) editor.save();\r\n        tinymce.remove(editor);\r\n    },\r\n    reInitTextEditor: async function (target, options) {\r\n        // Ensure TinyMCE is loaded\r\n        if (typeof DeferredLoader !== 'undefined') {\r\n            await DeferredLoader.loadTinyMCE();\r\n        }\r\n\r\n        var editor = tinymce.get(target.id);\r\n        if (editor) {\r\n            editor.setContent(\"\");\r\n        }\r\n        await this.destroyTextEditor(target);\r\n        await this.initTextEditor(target, options);\r\n    },\r\n    reInitTextEditorRetainContent: async function (target, options) {\r\n        // Ensure TinyMCE is loaded\r\n        if (typeof DeferredLoader !== 'undefined') {\r\n            await DeferredLoader.loadTinyMCE();\r\n        }\r\n\r\n        await this.destroyTextEditor(target);\r\n        await this.initTextEditor(target, options);\r\n    },\r\n    getFileIcon: function (file) {\r\n        var $icon = $('<i class=\"fas\"></i>');\r\n\r\n        switch (file.type) {\r\n            case 'image/jpeg':\r\n            case 'image/png':\r\n                $icon.addClass('fa-file-image');\r\n                break;\r\n            case 'text/html':\r\n            case 'text/css':\r\n            case 'text/javascript':\r\n                $icon.addClass('fa-file-code');\r\n                break;\r\n            case 'text/csv':\r\n                $icon.addClass('fa-file-csv');\r\n                break;\r\n            case 'audio/mp3':\r\n            case 'audio/ogg':\r\n            case 'audio/webm':\r\n                $icon.addClass('fa-file-audio');\r\n                break;\r\n            case 'video/mp4':\r\n            case 'video/ogg':\r\n            case 'video/webm':\r\n                $icon.addClass('fa-file-video');\r\n                break;\r\n            case 'application/word':\r\n            case 'application/vnd.openxmlformats-officedocument.wordprocessingml.document':\r\n                $icon.addClass('fa-file-word');\r\n                break;\r\n            case 'application/excel':\r\n            case 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet':\r\n                $icon.addClass('fa-file-excel');\r\n                break;\r\n            case 'application/pdf':\r\n                $icon.addClass('fa-file-pdf');\r\n                break;\r\n            case 'application/zip':\r\n                $icon.addClass('fa-file-archive');\r\n                break;\r\n            case 'application/vnd.openxmlformats-officedocument.presentationml.presentation':\r\n                $icon.addClass('fa-file-powerpoint');\r\n                break;\r\n            default:\r\n                $icon.addClass('fa-file');\r\n                break;\r\n        }\r\n\r\n        return $icon;\r\n    },\r\n    mathQueueTypeSet: function () {\r\n        if (window.MathJax.isReady) {\r\n            var math = document.getElementsByClassName(\"mce_equation\");\r\n            setTimeout(function () {\r\n                MathJax.Hub.Queue([\"Typeset\", MathJax.Hub, math]);\r\n                fixMathJaxEquationSelection(window.Utils.getActiveEditor());\r\n            }, 3331);\r\n        }\r\n    },\r\n    removeAutoPlayAttrFromVideo: function () {\r\n        var videoTags = $(\".mce-preview-object.mce-object-iframe > iframe\");\r\n        if (videoTags.length == 0)\r\n            return;\r\n\r\n        setTimeout(function () {\r\n            $.each(videoTags, function (i, video) {\r\n                var frameContent = $(video).contents().find('body').html();\r\n                if (frameContent) {\r\n                    $(video).contents().find('body').html(frameContent.replace(\"autoplay\", \"\"));\r\n                }\r\n            });\r\n        }, 500);\r\n    },\r\n    isIOSMobileApp: function () {\r\n        return !!(window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.handler);\r\n    },\r\n    isAndroidMobileApp: function () {\r\n        return !!(typeof (Android) !== 'undefined' && Android.handleJS);\r\n    },\r\n    showProcessingOverlay: function () {\r\n        $('body').append('<div class=\"processing-overlay\">'\r\n            + '<div class=\"spinner-border text-primary\" role=\"status\">'\r\n            + '<span class=\"sr-only\">Processing...</span>'\r\n            + '</div></div>');\r\n    },\r\n    hideProcessingOverlay: function () {\r\n        $('.processing-overlay').remove();\r\n    },\r\n    showNotificationToast: function (message, delay) {\r\n        $('.toast-notification .btn-close').off('click');\r\n        $('.toast-notification .btn-close').on('click', function (e) {\r\n            $('.toast-notification').removeClass('show');\r\n        });\r\n        $('.toast-notification .toast-body').html(message);\r\n        $('.toast-notification').addClass('show');\r\n        setTimeout(function () {\r\n            $('.toast-notification').removeClass('show');\r\n        }, (delay || 6000));\r\n    },\r\n    // Math Equation methods\r\n    insertImageNode: function (imgURL, strAlt) {\r\n        var html = \"<img src='\" + imgURL + \"'/>\";\r\n        $(\".mco-detect-content\").html(html);\r\n        $(\".mco-detect-content > img\").on(\"load\", function () {\r\n            var size = helperFunctions.calculateAspectRatio(this.width, this.height, 160, 160);\r\n            html = \"<img src='\" + imgURL + \"' resid='\" + data.questionId + \"' \"\r\n                + \"alt='\" + strAlt + \"' title='\" + strAlt + \"' isequation='0' \"\r\n                + \"width='\" + parseInt(size.width, 10) + \"px' height='\" + parseInt(size.height) + \"px' \"\r\n                + \"style='vertical-align: middle;' />\";\r\n            window.Utils.getActiveEditor().execCommand('mceInsertContent', false, html);\r\n            $(\".mco-detect-content\").html(\"\");\r\n        });\r\n    },\r\n    insertMEENode: function (imgURL, strAlt) {\r\n        var html = \"<img src='\" + imgURL.imageSrc + \"'/>\";\r\n        var qnId = $(\"#txtQuestion\").attr(\"questionid\");\r\n        $(\".mco-detect-content\").html(html);\r\n        $(\".mco-detect-content > img\").on(\"load\", function () {\r\n            html = \"<img src='\" + imgURL.imageSrc + \"' resid='\" + qnId + \"' \"\r\n                + \"alt='\" + strAlt + \"' title='\" + strAlt + \"' isequation='1' \"\r\n                + \"width='\" + this.width + \"px' height='\" + this.height + \"px' \"\r\n                + \"style='vertical-align: middle;' />\";\r\n            window.Utils.getActiveEditor().execCommand('mceInsertContent', false, html);\r\n            $(\".mco-detect-content\").html(\"\");\r\n        });\r\n    },\r\n    insertFraction: function (imgURL, fracXML, ans_fracXML, strAlt) {\r\n        var html = \"<img src='\" + imgURL + \"'/>\";\r\n        var qnId = $(\"#txtQuestion\").attr(\"questionid\");\r\n        $(\".mco-detect-content\").html(html);\r\n        $(\".mco-detect-content > img\").on(\"load\", function () {\r\n            html = \"<img src='\" + imgURL + \"' resid='\" + qnId + \"' \"\r\n                + \"alt='\" + strAlt + \"' title='\" + strAlt + \"' isequation='0' isfraction='1' \"\r\n                + \"fractionxml='\" + fracXML + \"' \" + \"ans_fracxml='\" + ans_fracXML + \"' \"\r\n                + \"width='\" + this.width + \"px' height='\" + this.height + \"px' \"\r\n                + \"style='vertical-align: middle;' />\";\r\n            // window.Utils.getActiveEditor().execCommand('mceInsertRawHTML', false, html);\r\n            window.Utils.getActiveEditor().selection.setContent(html, { format: 'raw' });\r\n            $(\".mco-detect-content\").html(\"\");\r\n        });\r\n    },\r\n    updateFraction: function (imgURL, fracXML, ans_fracXML, strAlt) {\r\n        var html = \"<img src='\" + imgURL + \"'/>\";\r\n        var qnId = $(\"#txtQuestion\").attr(\"questionid\");\r\n        $(\".mco-detect-content\").html(html);\r\n        $(\".mco-detect-content > img\").on(\"load\", function () {\r\n            html = \"<img src='\" + imgURL + \"' resid='\" + qnId + \"' \"\r\n                + \"alt='\" + strAlt + \"' title='\" + strAlt + \"' isequation='0' isfraction='1' \"\r\n                + \"fractionxml='\" + fracXML + \"' \" + \"ans_fracxml='\" + ans_fracXML + \"' \"\r\n                + \"width='\" + this.width + \"px' height='\" + this.height + \"px' \"\r\n                + \"style='vertical-align: middle;' />\";\r\n            editor = window.Utils.getActiveEditor();\r\n            var richtext = editor.getContent({ format: 'raw' })\r\n            var url = imgURL.replace(/^http?:/, '');\r\n            if (url.lastIndexOf(\"?t=\") !== -1) {\r\n                url = url.substring(0, url.lastIndexOf(\"?t=\"));\r\n            }\r\n            var images = window.Utils.getActiveEditor().dom.select(\"img\");\r\n            for (var i = 0; i < images.length; i++) {\r\n                var imgurl = images[i].getAttribute(\"src\");\r\n                var remImgUrl = imgurl.replace(/\\?t=[0-9\\.]+/g, '').replace(/^http?:/, '');\r\n                if (remImgUrl.toLowerCase() == url.toLowerCase()) {\r\n                    var imgTagCleanMceAttr = images[i].outerHTML.replace(/\\sdata(.*?)\"(.*?)\"/, '');\r\n                    richtext = richtext.replace(imgTagCleanMceAttr, html);\r\n                }\r\n            }\r\n            var ret = editor.setContent(richtext, { format: 'raw' });\r\n            $(\".mco-detect-content\").html(\"\");\r\n        });\r\n    },\r\n    updateImageNodes: function () {\r\n        var images = window.Utils.getActiveEditor().dom.select(\"img\");\r\n        var seconds = new Date().getTime() / 1000;\r\n        for (var i = 0; i < images.length; i++) {\r\n            if (images[i].getAttribute(\"status\") === \"updated\") {\r\n                continue;\r\n            }\r\n\r\n            var url = images[i].getAttribute(\"src\");\r\n            if (url.lastIndexOf(\"?t=\") !== -1) {\r\n                url = url.substring(0, url.lastIndexOf(\"?t=\"));\r\n            }\r\n            images[i].setAttribute(\"src\", url + \"?t=\" + seconds);\r\n            images[i].setAttribute(\"status\", \"updated\");\r\n\r\n            if (images[i].getAttribute(\"isequation\") == \"1\")\r\n                window.Utils.resizeImage(images[i]);\r\n        }\r\n    },\r\n    resizeImage: function (img) {\r\n        var html = \"<img src='\" + img.getAttribute(\"src\") + \"'/>\";\r\n        $(\".mco-detect-content\").html(html);\r\n        $(\".mco-detect-content > img\").on(\"load\", function () {\r\n            img.setAttribute(\"width\", this.width + \"px\");\r\n            img.setAttribute(\"height\", this.height + \"px\");\r\n            $(\".mco-detect-content\").html(\"\");\r\n        });\r\n    },\r\n    resetImageStatus: function () {\r\n        var images = window.Utils.getActiveEditor().dom.select(\"img\");\r\n        for (var i = 0; i < images.length; i++) {\r\n            images[i].setAttribute(\"status\", \"\");\r\n        }\r\n    },\r\n    getMEEIds: function (editor_id) {\r\n        var meeURLPattern = /\\{[0-9a-zA-Z\\-]{36}\\}\\/meeImage.png/i;\r\n        var meeIdPattern = /[0-9a-zA-Z\\-]{36}/i;\r\n        var images = window.Utils.getActiveEditor().dom.select(\"img\");\r\n        var meeIds = [];\r\n        for (var i = 0; i < images.length; i++) {\r\n            var url = images[i].getAttribute(\"src\");\r\n            var match = decodeURI(url).match(meeURLPattern);\r\n            if (match === null) {\r\n                continue;\r\n            }\r\n            meeIds.push(match[0].match(meeIdPattern)[0]);\r\n        }\r\n        return meeIds.join(\";\");\r\n    },\r\n    getFracIds: function (editor_id) {\r\n        var fracURLPattern = /\\{[0-9a-zA-Z\\-]{36}\\}\\/mce_fib_frac.png/i;\r\n        var fracIdPattern = /[0-9a-zA-Z\\-]{36}/i;\r\n        var images = window.Utils.getActiveEditor().dom.select(\"img\");\r\n        var fracIds = [];\r\n        for (var i = 0; i < images.length; i++) {\r\n            var url = images[i].getAttribute(\"src\");\r\n            var match = decodeURI(url).match(fracURLPattern);\r\n            if (match === null) {\r\n                continue;\r\n            }\r\n            fracIds.push(match[0].match(fracIdPattern)[0]);\r\n        }\r\n        return fracIds.join(\";\");\r\n    },\r\n    insertFractionNode: function (type) {\r\n        var html = \"\";\r\n        switch (type) {\r\n            case \"simplefraction\":\r\n                html = \"<div style='display: inline-block'>\"\r\n                    + \"<table style='display: inline-block; border-collapse: collapse; border: 0px; vertical-align: middle;'>\"\r\n                    + \"<tbody><tr><td style='padding: 5px; border: 0px; border-bottom: 1px solid #000000;'><span style='font-size: 13px'>[x]</span></td></tr>\"\r\n                    + \"<tr><td style='padding: 5px; border: 0px;'><span style='font-size: 13px'>[y]</span></td></tr></tbody></table></div>\";\r\n                break;\r\n\r\n            case \"mixedfraction\":\r\n                html = \"<div style='display: inline-block'>\"\r\n                    + \"<table style='display: inline-block; border-collapse: collapse; border: 0px; vertical-align: middle;'>\"\r\n                    + \"<tbody><tr><td rowspan='2' style='padding: 5px; border: 0px;'><span style='font-size: 13px'>[x]</span></td>\"\r\n                    + \"<td style='padding: 5px; border: 0px; border-bottom: 1px solid #000000;'><span style='font-size: 13px'>[y]</span></td></tr>\"\r\n                    + \"<tr><td style='padding: 5px; border: 0px;'><span style='font-size: 13px'>[z]</span></td></tr></tbody></table></div>\";\r\n                break;\r\n        }\r\n        window.Utils.getActiveEditor().execCommand('mceInsertContent', false, html);\r\n    },\r\n    insertHTMLMEENode: function (html) {\r\n        $(\".mco-detect-content\").html(html);\r\n        var contents = html;\r\n        if (html.indexOf('<math') >= 0) {\r\n            contents = window.Utils.convertMathJax2MathMl(html);\r\n            // for insert/update equation\r\n            window.Utils.getActiveEditor().selection.setContent(contents, { format: 'raw' });\r\n        \r\n            var ed = window.Utils.getActiveEditor();\r\n            if (selectedEqnNodeId) {\r\n                var prevSelectedNode = ed.dom.get(selectedEqnNodeId);\r\n                ed.selection.select(prevSelectedNode);\r\n            }\r\n            window.Utils.displayMathML(ed, contents, ed, selectedEqnNodeId,\r\n                function () {\r\n                    startEquation = ed.dom.getParent(ed.selection.getEnd(), '.mce_equation');\r\n                    fixEqnCaretPos(ed);\r\n                    fixMathJaxEquationSelection(ed);\r\n                    //console.log(\"callback func here\");\r\n                });\r\n        }\r\n\r\n        // Set the content\r\n        //window.Utils.getActiveEditor().selection.setContent(contents, { format: 'raw' });\r\n        //$(\".mco-detect-content\").html(\"\");\r\n    },\r\n    insertHTMLMEEAnsNode: function (html, safIdx) {\r\n        $(\".mco-detect-content\").html(html);\r\n        var contents = html;\r\n        if (html.indexOf('<math') >= 0) {\r\n            var answerBoxes = $(contents).find(\"annotation\").first().html();\r\n            \r\n            $(\"span.mce_saf_box[idx='\" + safIdx + \"']\").html(html);\r\n            $(\"input.mce_saf_txt[idx='\" + safIdx + \"']\").val(answerBoxes).trigger(\"change\");\r\n        }\r\n    },\r\n    convertMathJax2MathMl: function (sMathJax) {\r\n        var contentHtml = document.createElement('div');\r\n        contentHtml.innerHTML = sMathJax;\r\n\r\n        var eqnElements = contentHtml.getElementsByClassName('mce_equation');\r\n\r\n        if (eqnElements.length > 0) {\r\n            for (var i = 0; i < eqnElements.length; i++) {\r\n                var elem = eqnElements[i];\r\n                elem.id = \"mce_equation\" + \"_\" + Math.floor(Math.random() * 9999);\r\n\r\n                if (elem.classList.contains(\"mce_equation_new\")) {\r\n                    elem.classList.remove(\"mce_equation_new\");\r\n                }\r\n\r\n                var mathmlScript = elem.getElementsByTagName('script')[0];\r\n\r\n                var parentElem = elem.parentElement;\r\n                var textSpace = document.createTextNode(\"\\u00A0\");\r\n                if (elem.previousSibling === null)\r\n                    parentElem.insertBefore(textSpace, elem);\r\n                if (elem.nextSibling === null)\r\n                    parentElem.appendChild(textSpace);\r\n\r\n                if (!mathmlScript)\r\n                    continue;\r\n                if (mathmlScript.getAttribute(\"type\") === \"math/mml\" ||\r\n                    mathmlScript.getAttribute(\"type\") === \"mce-math/mml\") {\r\n                    var mathMLStr = mathmlScript.innerHTML.replace(/<(menclose)[^>]+>/gi, \"\").replace(/<\\/(menclose)+>/g, \"\");\r\n                    elem.innerHTML = mathMLStr.replace(\"// <![CDATA[\", \"\").replace(\"// ]]>\", \"\");\r\n                }\r\n            }\r\n        } else if (contentHtml.getElementsByTagName(\"SCRIPT\")[0]\r\n            && contentHtml.getElementsByTagName(\"SCRIPT\")[0].type === \"math/mml\"\r\n        ) {\r\n            contentHtml.innerHTML = contentHtml.getElementsByTagName(\"SCRIPT\")[0].innerHTML;\r\n        }\r\n        // Always cleanup.\r\n        //Strip MathJax_Message\r\n        if (contentHtml.children.MathJax_Message)\r\n            contentHtml.children.MathJax_Message.remove();\r\n        var selectedEqns = contentHtml.getElementsByClassName(\"mce_equation-selected\");\r\n        // Remove selected equation style.\r\n        for (var i = 0; i < selectedEqns.length; i++) {\r\n            selectedEqns[i].classList.remove(\"mce_equation-selected\");\r\n        }\r\n\r\n        return contentHtml.innerHTML;\r\n    },\r\n    // Use MathJax to queue and load MathML.\r\n    displayMathML: function (element, mathHtml, tinyMceEditor, selectedId, callback) {\r\n\r\n        var element = element.getElement();\r\n        var MathJax = window.MathJax;\r\n        if (tinyMceEditor && tinyMceEditor.contentWindow && tinyMceEditor.contentWindow.MathJax) {\r\n            MathJax = tinyMceEditor.contentWindow.MathJax\r\n        }\r\n\r\n        if (!MathJax)\r\n            return;\r\n\r\n        if (element.innerHTML) {\r\n            // Always convert jax to mathml.\r\n            element.innerHTML = window.Utils.convertMathJax2MathMl(element.innerHTML);\r\n        }\r\n\r\n        MathJax.typeset(); //MathJax 3.X.X Convert MathML to MathJax\r\n        //element.style.visibility = \"hidden\";\r\n        //MathJax.Hub.processSectionDelay = 0;\r\n        //MathJax.Hub.Queue(function () {\r\n        //    element.style.visibility = \"hidden\";\r\n\r\n        //    var mathMrowElems = element.getElementsByTagName(\"mrow\");\r\n        //    for (var i = 0; i < mathMrowElems.length; i++) {\r\n        //        var mrowElm = mathMrowElems[i];\r\n        //        var mrowParentElm = mrowElm.parentElement;\r\n        //        if (mrowElm.getAttribute(\"is_answer\") === \"true\" && mrowParentElm.tagName !== \"menclose\") {\r\n        //            // Create a new <menclose notation=\"circle box\"> element\r\n        //            var mencloseElem = document.createElement('menclose');\r\n        //            mencloseElem.setAttribute(\"notation\", \"box\");\r\n        //            mencloseElem.appendChild(mrowElm.cloneNode(true));\r\n\r\n        //            mrowParentElm.replaceChild(mencloseElem, mrowElm);\r\n        //        }\r\n        //    }\r\n        //});\r\n        //MathJax.Hub.Queue([\"Typeset\", MathJax.Hub, element]);\r\n        //MathJax.Hub.Queue(function () {\r\n        //    //Strip MathJax_Message\r\n        //    element = window.Utils.cleanup(element);\r\n\r\n        //    if (tinyMceEditor) {\r\n        //        tinyMceEditor.setProgressState(false);\r\n\r\n        //        if (selectedId) {\r\n        //            var selectedElem = element.id === selectedId ? element : element.querySelector(\"#\" + selectedId);\r\n        //            tinyMceEditor.selection.select(selectedElem);\r\n        //            tinyMceEditor.nodeChanged();\r\n        //        }\r\n        //    }\r\n\r\n        //    // Remove tab index.\r\n        //    var mathjaxElements = element.getElementsByClassName(\"MathJax\");\r\n        //    for (var i = 0; i < mathjaxElements.length; i++) {\r\n        //        mathjaxElements[i].removeAttribute(\"tabIndex\");\r\n        //    }\r\n\r\n        //    element.style.visibility = \"\";\r\n\r\n        //    if (callback)\r\n        //        callback();\r\n        //});\r\n    },\r\n    addMathJaxQueue: function (callback) {\r\n        MathJax.Hub.Queue(function () {\r\n            callback();\r\n        })\r\n    },\r\n\r\n    // Check if string contains <math> tag.\r\n    containsMathML: function (strElement) {\r\n        return strElement.indexOf('<math') >= 0\r\n    },\r\n\r\n    listenForError: function () {\r\n        MathJax.Hub.Register.MessageHook(\"Math Processing Error\", function (message) {\r\n            //  do something with the error.  message[2] is the Error object that records the problem.\r\n            console.log(message);\r\n        });\r\n    },\r\n    cleanup: function (element) {\r\n        //Strip MathJax_Message\r\n        var mathJaxDivs = element.getElementsByTagName(\"div\");\r\n        var mathJaxDivIndex = mathJaxDivs.length;\r\n        while (mathJaxDivIndex--) {\r\n            var mathJaxDiv = mathJaxDivs[mathJaxDivIndex];\r\n            if (!mathJaxDiv)\r\n                continue;\r\n\r\n            var mathJaxDivParent = mathJaxDiv.parentElement;\r\n\r\n            switch (mathJaxDiv.id) {\r\n                case \"MathJax_Preview\":\r\n                case \"MathJax_Message\":\r\n                case \"MathJax_Hidden\":\r\n                case \"MathJax_Font_Test\":\r\n                    mathJaxDiv.remove();\r\n                    if (mathJaxDivParent.innerHTML.length === 0)\r\n                        mathJaxDivParent.remove();\r\n                    break;\r\n                default:\r\n                    break;\r\n            }\r\n        }\r\n        return element;\r\n    },\r\n    addMathJaxScript: function (ed, mathJaxUrl, mathJaxConfigUrl) {\r\n        if (!mathJaxUrl)\r\n            mathJaxUrl = \"plugins/MathJax-2.7.2/MathJax.js\" + \"?config=TeX-MML-AM_HTMLorMML\";\r\n        if (!mathJaxConfigUrl)\r\n            mathJaxConfigUrl = \"config/mathjax-config.js\";\r\n        var editor = window.Utils.getActiveEditor().getBody();\r\n        editor.designMode = 'off';\r\n\r\n        // Add the MathJax.js to editor's iframe.\r\n        var scriptElm = ed.dom.create('script', {\r\n            id: ed.dom.uniqueId(),\r\n            type: 'text/javascript',\r\n            src: mathJaxUrl\r\n        });\r\n        window.Utils.getActiveEditor().getDoc().getElementsByTagName('head')[0].appendChild(scriptElm);\r\n\r\n        // Setup MathJax config script tag.\r\n        var scriptElmMathJaxConfig = window.Utils.getActiveEditor().dom.create('script', {\r\n            id: window.Utils.getActiveEditor().dom.uniqueId(),\r\n            type: 'text/javascript',\r\n            src: mathJaxConfigUrl\r\n        });\r\n\r\n        // Only load the configuration script if MathJax.js is loaded.\r\n        scriptElm.onload = function () {\r\n            window.Utils.getActiveEditor().getDoc().getElementsByTagName('head')[0].appendChild(scriptElmMathJaxConfig);\r\n            window.Utils.getActiveEditor().contentWindow.MathJax.Hub.Queue(function () {\r\n                isMathJaxLoaded = true;\r\n            });\r\n        };\r\n\r\n        editor.designMode = 'on';\r\n    },\r\n    getActiveEditor: function () {\r\n        return tinyMCE.activeEditor;\r\n    },\r\n    getSingleAnswerFormulaText: function (safIdx) {\r\n        return $(\"span.mce_saf_box[idx='\" + safIdx + \"'] > span.mce_equation\").first().html();\r\n    },\r\n    isMobileViewpoint: function () {\r\n        return window.innerWidth <= 576;\r\n    },\r\n    showAndHideProcessingOverlay: function (d) {\r\n        window.Utils.showProcessingOverlay();\r\n        setTimeout(function () {\r\n            window.Utils.hideProcessingOverlay();\r\n        }, d);\r\n    },\r\n    showDownloadAppToastNotification: function (t) {\r\n        if (t == 1) {\r\n            $(\".toast-download-notification\").addClass(\"show\");\r\n            $(\".app-header\").css(\"margin-bottom\", \"4.5rem\");\r\n            if (window.Utils.isIOSMobileApp() || window.Utils.isAndroidMobileApp() || window.Utils.isMobileViewpoint()) {\r\n                $(\".toast-download-notification .toast-body .app-prompt-bar .text\").html(i18next.t(\"common_btn_downloadapp_notiftext_mobile\"));\r\n            }\r\n            else {\r\n                $(\".toast-download-notification .toast-body .app-prompt-bar .text\").html(i18next.t(\"common_btn_downloadapp_notiftext_desktop\"));\r\n            }\r\n            bindActionsDownloadAppToastNotification();\r\n        }\r\n    }\r\n};\r\n\r\nfunction bindActionsDownloadAppToastNotification() {\r\n    $(\".toast-download-notification .btn-close\").off(\"click\").on(\"click\", function () {\r\n        $(\".toast-download-notification\").addClass(\"d-none\");\r\n        $(\".toast-download-notification\").removeClass(\"show\");\r\n        $(\".app-header\").css(\"margin-bottom\", \"0\");\r\n    });\r\n\r\n    $(\".toast-download-notification .btn-download-primary\").off(\"click\").on(\"click\", function () {\r\n        setMceAppData();\r\n        window.Utils.showAndHideProcessingOverlay(500);\r\n    });\r\n}\r\n\r\nconst popupCenter = ({ url, title, w, h }) => {\r\n    // Fixes dual-screen position                             Most browsers      Firefox\r\n    const dualScreenLeft = window.screenLeft !== undefined ? window.screenLeft : window.screenX;\r\n    const dualScreenTop = window.screenTop !== undefined ? window.screenTop : window.screenY;\r\n\r\n    const width = window.innerWidth ? window.innerWidth : document.documentElement.clientWidth ? document.documentElement.clientWidth : screen.width;\r\n    const height = window.innerHeight ? window.innerHeight : document.documentElement.clientHeight ? document.documentElement.clientHeight : screen.height;\r\n\r\n    const systemZoom = width / window.screen.availWidth;\r\n    const left = (width - w) / 2 / systemZoom + dualScreenLeft\r\n    const top = (height - h) / 2 / systemZoom + dualScreenTop\r\n    const newWindow = window.open(url, title,\r\n        `\r\n      scrollbars=yes,\r\n      width=${w / systemZoom}, \r\n      height=${h / systemZoom}, \r\n      top=${top}, \r\n      left=${left}\r\n      `\r\n    )\r\n\r\n    if (window.focus) newWindow.focus();\r\n}\r\n\r\n// Convert all MathJax element to MathML\r\n// onBeforeSetContent, prepare the mathjax with mathml elements.\r\nfunction replaceMathJax2MathMl(ed, o) {\r\n    var out_data = {};\r\n    o.content = mathJaxHelperFunctions.convertMathJax2MathMl(o.content, out_data);\r\n    if (out_data.new_element_id)\r\n        selectedEqnNodeId = out_data.new_element_id;\r\n\r\n    return o.content;\r\n}\r\n\r\nfunction fixMathJaxEquationSelection(ed) {\r\n    if (startEquation) {\r\n        ed.focus();\r\n        ed.selection.select(startEquation);\r\n        if (ed.selection.getNode())\r\n            selectedEqnNodeId = ed.selection.getNode().id;\r\n        startEquation.classList.add(\"mce_equation-selected\");\r\n        ed.nodeChanged();\r\n        //alert(\"Focused\");\r\n    } else\r\n        selectedEqnNodeId = null;\r\n}\r\n\r\n// Add a space before and after the mce_equation element.\r\n// To fix clicking of text before and after element.\r\nfunction fixEqnCaretPos(ed) {\r\n    var selectedNode = startEquation || ed.selection.getNode();\r\n    if (!isMathJaxEqn(selectedNode))\r\n        return;\r\n    var parentElem = selectedNode.parentElement;\r\n    var textSpace = document.createTextNode(\" \");\r\n    if (selectedNode.previousSibling === null)\r\n        parentElem.insertBefore(textSpace, selectedNode);\r\n    if (selectedNode.nextSibling === null)\r\n        parentElem.appendChild(textSpace);\r\n}\r\n\r\n// Check if it is MathJax element in tinymce.\r\n// MathJax rendered equation is inside span element\r\n// with className = 'mce_equation'\r\nfunction isMathJaxEqn(elem) {\r\n    return (elem && elem.nodeName === 'SPAN' && elem.className === 'mce_equation');\r\n}\r\n\r\n$(document).ready(function () {\r\n    $(document).on('click', '[data-toggle=\"password\"]', function (e) {\r\n        var icon = $(this).find('.fas');\r\n        $(icon).toggleClass('fa-eye-slash');\r\n\r\n        var target = $(this).attr('data-target');\r\n        if ($(target).attr(\"type\") === 'password') $(target).attr('type', 'text');\r\n        else $(target).attr('type', 'password');\r\n    });\r\n\r\n    $(document).on('click', '[data-toggle=\"dialog\"]', function (e) {\r\n        var dialog = $(e.target).closest('.dialog');\r\n\r\n        if (dialog && !$(dialog).hasClass('open')) {\r\n            setTimeout(function () {\r\n                $(dialog).toggleClass('open');\r\n                $(dialog).find('.dialog-menu').toggleClass('show');\r\n            });\r\n        }\r\n    });\r\n\r\n    $(document).on('autocomplete:opened', function (e) {\r\n        var autocomplete = $(e.target).closest('.algolia-autocomplete');\r\n        $(autocomplete).find('.aa-dropdown-menu').css('z-index', '');\r\n    });\r\n\r\n    $(document).on('hide.bs.dropdown', function (e) {\r\n        var header = $(e.target).closest('.article-header');\r\n\r\n        if ($(header).hasClass('dropdown-open')) {\r\n            $(header).removeClass('dropdown-open');\r\n        }\r\n    });\r\n\r\n    $(document).on('show.bs.collapse', function (e) {\r\n        if (!$(e.target).closest('.collapsible').hasClass('show')) {\r\n            $(e.target).closest('.collapsible').addClass('show');\r\n        }\r\n    });\r\n\r\n    $(document).on('hide.bs.collapse', function (e) {\r\n        if ($(e.target).closest('.collapsible').hasClass('show')) {\r\n            $(e.target).closest('.collapsible').removeClass('show');\r\n        }\r\n    });\r\n\r\n    $(document).on('show.bs.dropdown', function (e) {\r\n        var header = $(e.target).closest('.article-header');\r\n\r\n        if (!$(header).hasClass('dropdown-open')) {\r\n            $(header).addClass('dropdown-open');\r\n        }\r\n\r\n        if ($(e.target).closest('.dialog-menu').length === 0) {\r\n            if ($('.dialog.open').length === 1) {\r\n                $('.dialog.open .dialog-menu').removeClass('show');\r\n                $('.dialog.open').removeClass('open');\r\n            }\r\n        }\r\n    });\r\n\r\n    $(document).on('click', function (e) {\r\n        if ($(e.target).closest('.dialog-menu').length === 0) {\r\n            $('.dialog.open .dialog-menu').removeClass('show');\r\n            $('.dialog.open').removeClass('open');\r\n        }\r\n    });\r\n\r\n    $(document).on('click', '[data-toggle=\"drawer\"]', function (e) {\r\n        e.preventDefault();\r\n\r\n        var target = $(this).attr('data-target');\r\n        if ($(target).hasClass('show')) $('.drawer-toggle').remove();\r\n        else $('body').append('<div class=\"drawer-backdrop\"></div>');\r\n        $(target).toggleClass('show');\r\n    });\r\n\r\n    $(document).on('click', '.drawer-backdrop', function (e) {\r\n        $('.drawer-backdrop').remove();\r\n        $('.drawer.show').removeClass('show');\r\n    });\r\n\r\n    $(document).on('click', '[data-toggle=\"sidebar\"]', function (e) {\r\n        e.preventDefault();\r\n\r\n        var target = $(this).attr('data-target');\r\n\r\n        if ($(target).hasClass('collapse-sidebar')) {\r\n            $(target).removeClass('collapse-sidebar')\r\n        } else {\r\n            $(target).addClass('collapse-sidebar');\r\n        }\r\n    });\r\n\r\n    $(document).on('show.bs.modal', function (e) {\r\n        if ($('.modal.show').length > 0) {\r\n            if (!$('.modal.show').hasClass('modal-base')) {\r\n                $('.modal.show').addClass('modal-base');\r\n            }\r\n        }\r\n\r\n        if (!$('.modal-backdrop.show').hasClass('modal-backdrop-base')) {\r\n            $('.modal-backdrop.show').addClass('modal-backdrop-base');\r\n        }\r\n\r\n        if ((window != window.top) && window.top.postMessage) {\r\n            window.top.postMessage('show.bs.modal', '*');\r\n        }\r\n    });\r\n\r\n    $(document).on('shown.bs.modal', function (e) {\r\n        if ((window != window.top) && window.top.postMessage) {\r\n            window.top.postMessage('shown.bs.modal', '*');\r\n        }\r\n\r\n        $(document).off('focusin.modal');\r\n    });\r\n\r\n    $(document).on('hide.bs.modal', function (e) {\r\n        if ($('.modal.show.modal-base').length > 0) {\r\n            $('.modal.show.modal-base').removeClass('modal-base');\r\n        }\r\n\r\n        if ((window != window.top) && window.top.postMessage) {\r\n            window.top.postMessage('hide.bs.modal', '*');\r\n        }\r\n    });\r\n\r\n    $(document).on('hidden.bs.modal', function (e) {\r\n        if ($('.modal.show').length > 0) {\r\n            if (!$('body').hasClass('modal-open')) {\r\n                $('body').addClass('modal-open');\r\n            }\r\n        }\r\n\r\n        if ((window != window.top) && window.top.postMessage) {\r\n            window.top.postMessage('hidden.bs.modal', '*');\r\n        }\r\n    });\r\n\r\n    // PERFORMANCE OPTIMIZATION: Dropzone configuration moved to deferred initialization\r\n    // Dropzone is now loaded on-demand via DeferredLoader.loadDropzone()\r\n    // This configuration will be applied when Dropzone is actually loaded\r\n    // NOTE: Skip if Dropzone is still the proxy - real config happens in DeferredLoader\r\n    if (typeof Dropzone !== 'undefined' && Dropzone && !Dropzone._isProxy && Dropzone.prototype && Dropzone.prototype.defaultOptions) {\r\n        var initProxied = Dropzone.prototype.defaultOptions.init;\r\n        Dropzone.prototype.defaultOptions.init = function () {\r\n            var cancelEventHandler = function (e) {\r\n                return false;\r\n            };\r\n\r\n            var destroyProxied = this.destroy;\r\n            this.destroy = function () {\r\n                $(document).off('dragover', cancelEventHandler);\r\n                $(document).off('drop', cancelEventHandler);\r\n                destroyProxied.apply(this, [].slice.call(arguments));\r\n            };\r\n\r\n            $(document).on('dragover', cancelEventHandler);\r\n            $(document).on('drop', cancelEventHandler);\r\n            initProxied.apply(this, [].slice.call(arguments));\r\n        };\r\n    }\r\n\r\n    window.addEventListener('pagehide', function (event) {\r\n        // Check if the user is authenticated or not.\r\n        // If authenticated, delete the LoginToken cookie.\r\n        if (event.persisted) {\r\n            // Delete the LoginToken cookie by setting its value to an empty string and an expired date\r\n            document.cookie = \"loginToken=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;\";\r\n        }\r\n    });\r\n\r\n    if (window === window.top) {\r\n        window.addEventListener(\"message\", function (e) {\r\n            switch (e.data) {\r\n                case 'show.bs.modal':\r\n                case 'shown.bs.modal':\r\n                    if (!$('.modal.show .modal-iframe').hasClass('modal-muted')) {\r\n                        $('.modal.show .modal-iframe').addClass('modal-muted');\r\n                    }\r\n                    break;\r\n                case 'hide.bs.modal':\r\n                case 'hidden.bs.modal':\r\n                    if ($('.modal.show .modal-iframe').hasClass('modal-muted')) {\r\n                        $('.modal.show .modal-iframe').removeClass('modal-muted');\r\n                    }\r\n                    break;\r\n                default:\r\n                    break;\r\n            }\r\n        }, false);\r\n    }\r\n    // NOTIFICATIONS [START]\r\n\r\n    var $modalNotifContainer = $('.notification-modal');\r\n    var $modalNotifContainerDetails = $modalNotifContainer.find('.modal-notification-view-header-details-frame');\r\n    var $modalNotifContainerDelete = $modalNotifContainer.find('.modal-notification-view-header-delete-confirmation');\r\n\r\n    if (typeof newNotifications !== 'undefined') {\r\n        if (newNotifications !== \"0\")\r\n            $('.notify-bell .badge-dark').html(newNotifications); // display no. of new notifications\r\n    }\r\n\r\n    // bPop from AppHeader.ascx.cs\r\n    if (typeof bPop !== 'undefined') {\r\n        if (bPop === \"True\" && showAnnouncement === \"1\" && arrID[index] !== \"\") {\r\n            showShowPopupModal('/Lead/Common/ShowPopup.aspx');\r\n        }\r\n    }\r\n\r\n    function showShowPopupModal(srcUrl) {\r\n        $('.modal-announcement-view').find('iframe').attr('src', srcUrl);\r\n        $('.modal-announcement-view').on('keydown', function (e) {\r\n            if ((e.which == 27) && window._pageDirty) {\r\n                e.which = Number.NaN;\r\n                e.stopPropagation();\r\n                showCancelUploadConfirmationModal(function () {\r\n                    $('.modal-announcement-view').modal('hide');\r\n                });\r\n            }\r\n        });\r\n        $('.modal-announcement-view .btn-close').on('click', function (e) {\r\n            $('.modal-announcement-view').modal('hide');\r\n        });\r\n        $('.modal-announcement-view').on('hide.bs.modal', function (e) { });\r\n        $('.modal-announcement-view').modal('show');\r\n    }\r\n\r\n    // list notifications\r\n    $('.btn-notifications').on('click', function (e) {\r\n        var nowToday = moment();\r\n        $('.notify-bell').find('.list-notifications').empty();\r\n        $('.notify-bell').find('dropdown-menu').addClass('show');\r\n        // add loading\r\n        $('.notify-bell').find('.list-notifications').append(\"<div class='loading-section'>\"\r\n            + \"<div class='list-group-flush list-group notify-bell-body'>\"\r\n            + \"<div class='list-group-item list-group-item-action'>\"\r\n            + \"<div class='notification'>\"\r\n            + \"<div class='notification-body'>\"\r\n            + \"<div class='notification-text'>\"\r\n            + \"<div class='loading-state'>\"\r\n            + \"<div class='spinner-border text-primary' role='status'>\"\r\n            + \"<span class='sr-only' data-i18n='common_message_loading'></span>\"\r\n            + \"</div>\"\r\n            + \"</div>\"\r\n            + \"</div>\"\r\n            + \"<div class='text-muted'></div>\"\r\n            + \"</div>\"\r\n            + \"</div>\"\r\n            + \"</div>\"\r\n            + \"</div>\"\r\n            + \"</div>\");\r\n        $.post(\"/Lead/Notifications/Notifications.aspx\", { action: \"list\" },\r\n            function (results) {\r\n                try {\r\n                    results = results.replace(/\\\\\\,/g, \"\\,\");\r\n                    results = results.replace(/\\\\\\'/g, \"\\'\");\r\n                    datastr = JSON.parse(results);\r\n                    if (datastr.err === \"1\") {\r\n                        $('.loading-section').addClass('d-none');\r\n                        showMessage(i18next.t(datastr.msg), \"warning\");\r\n                    } else {\r\n                        $('.notify-bell').find('.list-notifications').empty();\r\n                        $('.notify-bell .badge-dark').html('');//datastr.unread\r\n                        if (datastr.notif.length > 0) {\r\n                            $(datastr.notif).each(function (key, item) {\r\n                                var unRead = item.read_flag === 't' ? '' : 'active';\r\n                                var posDate = moment(item.date_created);\r\n                                var diff = nowToday.diff(posDate);\r\n                                var diffDuration = moment.duration(diff);\r\n                                var duration = getDisplayDuration(diffDuration);\r\n                                var sender = strUserId == item.user_id ? i18next.t(\"common_label_you\") : item.user_fullname;\r\n                                $('.notify-bell').find('.list-notifications').append(\"<div class='list-group-flush list-group'>\" +\r\n                                    \"<div class='list-group-item list-group-item-action \" + unRead + \"'>\" +\r\n                                    \"<div class='notification'>\" +\r\n                                    \"<img src='/Lead/Common/get_avatar.aspx?id=\" + item.user_id +\"&size=s' style='border-radius: 50%;'>\" +\r\n                                    \"<div class='notification-body'>\" +\r\n                                    \"<div class='notification-text'>\" +\r\n                                    \"<span class='user-name notif-id' id='\" + item.notification_id + \"'>\" + sender + \"</span> \" +\r\n                                    \"<span data-i18n='common_text_sent_as_type_\" + item.module_id + \"'></span>\" +\r\n                                    \"</div>\" +\r\n                                    \"<div class='text-muted'>\" +\r\n                                    \"\" + duration + \"\" +\r\n                                    \"</div>\" +\r\n                                    \"</div>\" +\r\n                                    \"</div>\" +\r\n                                    \"</div>\" +\r\n                                    \"</div>\");\r\n                            });\r\n                        } else {\r\n                            $('.notify-bell').find('.list-notifications').empty();\r\n                            $('.notify-bell').find('.list-notifications').append(\"<div class='list-group-flush list-group'>\" +\r\n                                \"<div class='list-group-item list-group-item-empty'>\" +\r\n                                \"<div class='notification'>\" +\r\n                                \"<div class='notification-body'>\" +\r\n                                \"<div class='notification-text'>\" +\r\n                                \"<span class='text-muted' id='none_id' data-i18n='common_label_no_new_notifications'></span>\" +\r\n                                \"</div>\" +\r\n                                \"<div class='text-muted'> </div>\" +\r\n                                \"</div>\" +\r\n                                \"</div>\" +\r\n                                \"</div>\" +\r\n                                \"</div>\");\r\n                        }\r\n                        if ($(\"#none_id\").length > 0) {\r\n                            $(\".notification-mark-all-read a\").css({ \"cursor\": \"default\", \"text-decoration\": \"none\" });\r\n                        }\r\n                        $(\".list-notifications\").localize();\r\n                    }\r\n                } catch (e) { }\r\n            });\r\n    });\r\n\r\n    // [notify-bell-click-per-notification] notification details\r\n    $('.notify-bell .list-notifications').on('click', '.list-group-item-action', function (e) {\r\n        event.stopPropagation();\r\n        var $modal = $modalNotifContainerDetails;\r\n        var notifId = $(this).find('.notification-text').children('span').attr('id');\r\n        var $itemNotif = $(this).closest('.list-group-item');\r\n        $modal.find('.modal-body').empty();\r\n        $modal.find('.modal-title').empty();\r\n        if (datastr.notif.length > 0) {\r\n            $(datastr.notif).each(function (key, item) {\r\n                if (item.notification_id == notifId) {\r\n                    // mark as read when open\r\n                    $.post(\"/Lead/Notifications/Notifications.aspx\", { action: \"markasreadorunread\", notif_id: notifId, mark_as_read_flag: \"t\" },\r\n                        function (results) {\r\n                            try {\r\n                  