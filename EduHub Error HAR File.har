                       </button>\r\n                    </div>\r\n                    <div class=\"modal-body\">\r\n                        <nav class=\"navbar navbar-expand navbar-pagination\">\r\n                            <div class=\"navbar-text text-muted\">\r\n                                <span data-i18n=\"common_announcement\"></span>\r\n                                <span class=\"curr-ann\"></span>\r\n                                <span data-i18n=\"common_label_of\"></span>\r\n                                <span class=\"total-ann\"></span>\r\n                            </div>\r\n                        </nav>\r\n                        <div class=\"announcement\">\r\n                            <div class=\"announcement-date text-muted\">\r\n                                <span data-i18n=\"common_label_posted_on\"></span><span class=\"postdate-ann\"></span>\r\n                                <span data-i18n=\"common_label_from\"></span><span class=\"display-name\"></span>\r\n                            </div>\r\n                            <div class=\"announcement-message\">\r\n                                <iframe class=\"full\" id=\"popDivMsg\" src=\"\" frameborder=\"0\"></iframe>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"announcement-actions\">\r\n                            <div class=\"custom-control custom-checkbox\">\r\n                                <input type=\"checkbox\" class=\"custom-control-input\" id=\"chk_remove\" onclick=\"remove_popup()\">\r\n                                <label class=\"custom-control-label\" for=\"chk_remove\">\r\n                                    <span data-i18n=\"common_checkbox_no_popup_show\"></span>\r\n                                </label>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"modal-footer\">\r\n                        <button class=\"btn btn-light btn-previous-ann\" onclick=\"showAnn(-1)\" data-i18n=\"common_btn_previous\"></button>\r\n                        <button class=\"btn btn-primary btn-next-ann\" onclick=\"showAnn(1)\" data-i18n=\"common_btn_next\"></button>\r\n                        <button type=\"button\" class=\"btn btn-primary btn-close-popup d-none\" data-dismiss=\"modal\" data-i18n=\"common_btn_close\"></button>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    <div class=\"app-header-modal notification-modal\">\r\n        <div class=\"modal modal-notification-view-header-details-frame fade\" tabindex=\"-1\" role=\"dialog\" data-backdrop=\"static\" style=\"display: none;\" aria-hidden=\"true\">\r\n            <div class=\"modal-dialog modal-dialog-centered modal-lg\" role=\"document\">\r\n                <div class=\"modal-content\">\r\n                    <div class=\"modal-header\">\r\n                        <h5 class=\"modal-title\"></h5>\r\n                        <div class=\"dropdown\" style=\"margin-left: auto\">\r\n                            <button type=\"button\" class=\"close\" title=\"Close\" data-dismiss=\"modal\">\r\n                                <span aria-hidden=\"true\">×</span>\r\n                            </button>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"modal-body\">\r\n                          \r\n                    </div>\r\n                    <div class=\"modal-footer\">\r\n                        <button type=\"button\" class=\"btn btn-primary noti-close\" data-dismiss=\"modal\" data-i18n=\"common_btn_close\"></button>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"modal modal-notification-view-header-delete-confirmation fade\" tabindex=\"-1\" role=\"dialog\" data-backdrop=\"static\" style=\"display: none;\" aria-hidden=\"true\">\r\n            <div class=\"modal-dialog modal-dialog-centered\" role=\"document\">\r\n                <div class=\"modal-content\">\r\n                    <div class=\"modal-header\">\r\n                        <h5 class=\"modal-title\"><span data-i18n=\"common_label_confirmation\"></span></h5>\r\n                        <button type=\"button\" class=\"close\" title=\"Close\" data-dismiss=\"modal\">\r\n                            <span aria-hidden=\"true\">×</span>\r\n                        </button>\r\n                    </div>\r\n                    <div class=\"modal-body\">\r\n                        <p><span data-i18n=\"common_text_delete_message_notification\"></span></p>\r\n                    </div>\r\n                    <div class=\"modal-footer\">\r\n                        <button type=\"button\" class=\"btn btn-light\" data-dismiss=\"modal\"><span data-i18n=\"common_btn_cancel\"></span></button>\r\n                        <button type=\"button\" class=\"btn btn-primary\"><span data-i18n=\"common_btn_ok\"></span></button>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"modal modal-link-account fade\" tabindex=\"-1\" role=\"dialog\" data-backdrop=\"static\">\r\n        <div class=\"modal-dialog modal-dialog-centered modal-sm\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <h5 class=\"modal-title\" data-i18n=\"home-link-retail-acccount\">My Retail Account</h5>\r\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\">\r\n                        <span aria-hidden=\"true\">×</span>\r\n                    </button>\r\n                </div>\r\n                <div class=\"modal-body\">\r\n                    <form class=\"form-link-retail\">\r\n                        <div class=\"form-group\">\r\n                            <div class=\"input-group prepend\">\r\n                                <div class=\"input-group-prepend\">\r\n                                    <span class=\"input-group-text\">\r\n                                        <i class=\"fas fa-user\"></i>\r\n                                    </span>\r\n                                </div>\r\n                                <input type=\"text\" id=\"rsUID\" class=\"form-control input-username\" maxlength=\"64\" placeholder=\"Username\" autocomplete=\"off\">\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"form-group\">\r\n                            <div class=\"input-group prepend\">\r\n                                <div class=\"input-group-prepend\">\r\n                                    <span class=\"input-group-text\">\r\n                                        <i class=\"fas fa-building\"></i>\r\n                                    </span>\r\n                                </div>\r\n                                <input type=\"text\" id=\"rstxtSchool\" class=\"form-control form-input input-school\" placeholder=\"School\" autocomplete=\"off\">\r\n                            </div>\r\n                            <div class=\"form-text text-danger d-none\">\r\n                                <i class=\"fas fa-exclamation\"></i>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"form-group\">\r\n                            <div class=\"input-group prepend\">\r\n                                <div class=\"input-group-prepend\">\r\n                                    <span class=\"input-group-text\">\r\n                                        <i class=\"fas fa-key\"></i>\r\n                                    </span>\r\n                                </div>\r\n                                <input type=\"password\" id=\"rsPWD\" class=\"form-control input-password\" maxlength=\"64\" placeholder=\"Password\" autocomplete=\"off\">\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"form-group\">\r\n                            <button class=\"btn btn-primary btn-block btn-link-account\" type=\"button\" data-i18n=\"common_btn_submit\">\r\n                            </button>\r\n                        </div>\r\n                        <input type=\"hidden\" name=\"publickey\" id=\"publickey\" value=\"xaIeknsSTNSGNiTK8hfo2ENt0CP53Pl/5FZYTpJqU8jD/xvxUr4Dho2WgD129tR2MADByNs/CKP8VDbB+3PbKbJslwyLr4QNnE50hSzjxC1ohMWaAzPJiQph8wJyNRMXKs/jhrDyVeExyM+jCgx2/tVYIs6X+Sawe9+nwgOtvPc=\" />\r\n                    </form>\r\n                    <form class=\"form-reset-password-success d-none\">\r\n                        <div class=\"form-group\">\r\n                            <div class=\"text-dark\">\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"form-group\">\r\n                            <button class=\"btn btn-primary btn-block\" type=\"button\" data-dismiss=\"modal\" data-i18n=\"common_btn_close\">\r\n                            </button>\r\n                        </div>\r\n                    </form>\r\n                    <form class=\"form-reset-password-error d-none\">\r\n                        <div class=\"form-group\">\r\n                            <div class=\"text-danger\">\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"form-group\">\r\n                            <button class=\"btn btn-primary btn-block\" type=\"button\" data-dismiss=\"modal\" data-i18n=\"common_btn_close\">\r\n                            </button>\r\n                        </div>\r\n                        <input type=\"hidden\" name=\"rsSCH\" value=\"\" id=\"rsSCH\" />\r\n                    </form>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"modal modal-message fade\" tabindex=\"-1\"  role=\"dialog\" data-backdrop=\"static\">\r\n        <div class=\"modal-dialog modal-dialog-centered\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                 <div class=\"modal-header\">\r\n                    <h5 class=\"modal-title\" data-i18n=\"common_modal_message\"></h5>\r\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\" title=\"Close\">\r\n                        <span aria-hidden=\"true\">&times;</span>\r\n                    </button>\r\n                </div>\r\n                <div class=\"modal-body\">\r\n                    \r\n                    <form class=\"form-message-success result0 d-none\">\r\n                        <div class=\"form-group\">\r\n                            <!--    <h1><i class=\"fas fa-check-circle\"></i></h1> -->\r\n                                <p>Retail account verification is successful!\r\n                                    <br />\r\n                                    Your new content is now available in both\r\n                                        your School & Retail Accounts</p>\r\n                        </div>\r\n                    </form>                   \r\n                    <form class=\"form-message-error result2 d-none\">\r\n                        <div class=\"form-group\">\r\n                             <!--   <h1><i class=\"fas fa-exclamation-circle\"></i></h1> -->\r\n                                <p>The access code has been redeemed.</p>\r\n                        </div>\r\n                    </form>\r\n                    <form class=\"form-message-error result3 d-none\">\r\n                        <div class=\"form-group\">\r\n                       <!--         <h1><i class=\"fas fa-exclamation-circle\"></i></h1> -->\r\n                                <p>Please create an account to redeem your access code.</p>\r\n                                <small><em>Redirect to registration page...</em></small>\r\n                        </div>\r\n                    </form>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    <button class=\"btn btn-primary pull-right\" type=\"button\" data-i18n=\"common_btn_ok\" data-dismiss=\"modal\">OK </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"modal modal-launch-learning-message fade\" tabindex=\"-1\" role=\"dialog\" data-backdrop=\"static\">\r\n        <div class=\"modal-dialog modal-dialog-centered\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <h5 class=\"modal-title\" data-i18n=\"common_modal_contact_helpdesk\">Contact Helpdesk</h5>\r\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\" title=\"Close\">\r\n                        <span aria-hidden=\"true\">&times;</span>\r\n                    </button>\r\n                </div>\r\n                <div class=\"modal-body\">\r\n                    <p data-i18n=\"common_modal_contact_helpdesk_msg\">To access the Professional Development Portal, your email address needs to be synced. Contact us for assistance at <u>helpdesk@mceducation.com</u> or report an issue.</p>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    <button class=\"btn btn-primary pull-right\" type=\"button\" data-i18n=\"common_btn_report_issue\">Report An Issue</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"modal modal-registration-form fade\" tabindex=\"-1\" role=\"dialog\" data-backdrop=\"static\">\r\n        <div class=\"modal-dialog modal-track-assignment modal-iframe\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-body\">\r\n                    <nav class=\"navbar navbar-expand\">\r\n                        <ul class=\"navbar-nav\">\r\n                            <li class=\"nav-item\">\r\n                                <div class=\"item-text text-truncate\"><span data-i18n=\"home_create_account\">Create My Account</span></div>\r\n                            </li>\r\n                        </ul>\r\n                        <ul class=\"navbar-nav\">\r\n                            <li class=\"nav-item\">\r\n                                <button class=\"btn btn-light btn-close\" type=\"button\" title=\"Close\" data-dismiss=\"modal\">\r\n                                    <i class=\"fas fa-times\"></i>\r\n                                </button>\r\n                            </li>\r\n                        </ul>\r\n                    </nav>\r\n                    <div class=\"content\">\r\n                        <iframe class=\"full\" src=\"\" frameborder=\"0\" allowfullscreen></iframe>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"modal modal-enter-access-code fade\" tabindex=\"-1\" role=\"dialog\" data-backdrop=\"static\">\r\n        <div class=\"modal-dialog modal-dialog-centered\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <h5 class=\"modal-title\"><i class=\"fas fa-key\"></i>&nbsp; <span data-i18n=\"common_label_enter_acccess_code\">Enter Access Code</span></h5>\r\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\" title=\"Close\">\r\n                        <span aria-hidden=\"true\">&times;</span>\r\n                    </button>\r\n                </div>\r\n                <div class=\"modal-body\">\r\n                    <form class=\"form-input-access-code\">\r\n                        <div class=\"form-group\">\r\n                            <div class=\"input-group prepend\">\r\n                                <div id=\"divCode\" class=\"form-codes\">\r\n                                    <input autocomplete=\"off\" type=\"text\" id=\"code1\" maxlength=\"1\" />\r\n                                    <input autocomplete=\"off\" type=\"text\" id=\"code2\" maxlength=\"1\" />\r\n                                    <input autocomplete=\"off\" type=\"text\" id=\"code3\" maxlength=\"1\" />\r\n                                    <input autocomplete=\"off\" type=\"text\" id=\"code4\" maxlength=\"1\" />\r\n                                    <input autocomplete=\"off\" type=\"text\" id=\"code5\" maxlength=\"1\" />\r\n                                    <input autocomplete=\"off\" type=\"text\" id=\"code6\" maxlength=\"1\" />\r\n                                    <input autocomplete=\"off\" type=\"text\" id=\"code7\" maxlength=\"1\" />\r\n                                    <input autocomplete=\"off\" type=\"text\" id=\"code8\" maxlength=\"1\" />\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"form-text text-danger d-none\">\r\n                                <strong><span data-i18n=\"common_label_invalid_acccess_code\">Invalid access code</span> <i class=\"fas fa-exclamation\"></i></strong>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"form-group form-group-actions\">\r\n                            <button class=\"btn btn-light btn-clear\" type=\"button\" data-i18n=\"common_btn_clear_all\">Clear All</button>\r\n                            <button class=\"btn btn-primary\" type=\"button\" data-i18n=\"common_btn_submit\">Submit</button>\r\n                        </div>\r\n                    </form>\r\n                    <form class=\"form-input-access-code-success d-none\">\r\n                        <div class=\"form-group\">\r\n                            <div class=\"text-dark\">\r\n                                <h1><i class=\"fas fa-check-circle\"></i></h1>\r\n                                <h2><span data-i18n=\"common_label_access_code_validation_success\">Access Code Validation Success</span> <i class=\"fas fa-exclamation\"></i></h2>\r\n                                <span data-i18n=\"common_label_redirect_self_reg_page\">Redirecting to self-registration page...</span>\r\n                            </div>\r\n                        </div>\r\n                    </form>\r\n                    <form class=\"form-input-access-code-error d-none\">\r\n                        <div class=\"form-group\">\r\n                            <div class=\"text-dark\">\r\n                                <h1><i class=\"fas fa-times-circle\"></i></h1>\r\n                            </div>\r\n                        </div>\r\n                    </form>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    <div class=\"modal modal-migrate-confirmation fade\" tabindex=\"-1\" role=\"dialog\" data-backdrop=\"static\">\r\n        <div class=\"modal-dialog modal-dialog-centered\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <h5 class=\"modal-title\" data-i18n=\"common_message_warning\"></h5>\r\n                    <button type=\"button\" class=\"close\" title=\"Close\" data-dismiss=\"modal\" data-i18n=\"[title]common_btn_close\">\r\n                        <span aria-hidden=\"true\">&times;</span>\r\n                    </button>\r\n                </div>\r\n                <div class=\"modal-body\">\r\n                    <p></p>\r\n                    <input class=\"chk_agree\" type=\"checkbox\" />\r\n                    <span data-i18n=\"common_unassign_agree_checkbox\" class=\"label_agree\"></span>\r\n                    <br /><br />\r\n                    <form class=\"form-join-sch d-none\">\r\n                        <div class=\"form-group\">\r\n                            <div class=\"input-group prepend\">\r\n                                <div class=\"input-group-prepend\">\r\n                                    <span class=\"input-group-text\">\r\n                                        <i class=\"fas fa-key\"></i>\r\n                                    </span>\r\n                                </div>\r\n                                <input type=\"password\" id=\"jsPWD\" class=\"form-control input-password\" maxlength=\"64\" placeholder=\"Password\" autocomplete=\"off\" data-i18n=\"[placeholder]common_new_password\">\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"form-group\">\r\n                            <div class=\"input-group prepend\">\r\n                                <div class=\"input-group-prepend\">\r\n                                    <span class=\"input-group-text\">\r\n                                        <i class=\"fas fa-key\"></i>\r\n                                    </span>\r\n                                </div>\r\n                                <input type=\"password\" id=\"jsCFPWD\" class=\"form-control input-password\" maxlength=\"64\" placeholder=\"Confirm Password\" autocomplete=\"off\" data-i18n=\"[placeholder]common_confirm_password\">\r\n                            </div>\r\n                        </div>\r\n                    </form>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    <button type=\"button\" class=\"btn btn-light\" data-dismiss=\"modal\" data-i18n=\"common_btn_cancel\">Cancel</button>\r\n                    <button type=\"button\" class=\"btn btn-primary\" data-i18n=\"common_btn_ok\">OK</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"modal modal-consent-flag fade\" tabindex=\"-1\" role=\"dialog\" data-backdrop=\"static\">\r\n        <div class=\"modal-dialog modal-dialog-centered\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <h5 class=\"modal-title\" data-i18n=\"common_modal_welcome_to_mceduhub\">Welcome to MCEduHub!</h5>\r\n                </div>\r\n                <div id=\"consentFirstLoginNotes\" class=\"modal-body\" style=\"padding: 2rem 2rem 0;\">\r\n                    <p>\r\n                        By clicking <span style='font-style: italic; font-weight: 700'>Continue</span>, I agree to Marshall Cavendish Education <a href='/Lead/Login/Privacy.aspx' target='_blank'><strong><u>Privacy Policy</u></strong></a> and <a href='/Lead/Login/Terms.aspx' target='_blank'><strong><u>Terms of Use</u></strong></a>.\r\n                    </p>\r\n                    <p>\r\n                        To give you the best possible experience on our website, your data may be passed on to our partner and subjected to their privacy policy and terms of use.\r\n                    </p>\r\n                </div>\r\n                <div class=\"modal-footer\" style=\"border-top: 0; padding-bottom: 1.75rem\">\r\n                    <button id=\"btnContinueConsent\" type=\"button\" class=\"btn btn-secondary\" data-i18n=\"common_btn_continue\">Continue</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    \r\n    <div class=\"modal modal-input-useremail-pin fade\" tabindex=\"-1\" role=\"dialog\" data-backdrop=\"static\">\r\n        <div class=\"modal-dialog modal-dialog-centered\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <h5 class=\"modal-title\">\r\n                        <i class=\"fa fa-info-circle\" style=\"font-size: 18px; color: #238ae6\"></i>&nbsp;\r\n                        <span data-i18n=\"\">Email address</span>\r\n                    </h5>\r\n                    <button type=\"button\" class=\"close btn-close-inputuseremail\" title=\"Close\" data-dismiss=\"modal\">\r\n                        <span aria-hidden=\"true\">&times;</span>\r\n                    </button>\r\n                </div>\r\n                <div class=\"modal-body pl-5 pr-5\">\r\n                    <div class=\"d-flex flex-column\">\r\n                        <div class=\"message\">\r\n                            <form class=\"form-input-email\">\r\n                                <div class=\"form-group\">\r\n                                    <label for=\"inputEmailPIN\">Input a valid email address for this account.</label>\r\n                                    <input type=\"email\" class=\"form-control\" id=\"inputEmailPIN\" aria-describedby=\"emailHelp\">\r\n                                    <div class=\"form-text text-danger text-left d-none\">\r\n                                        Invalid email address <i class=\"fas fa-exclamation\"></i>\r\n                                    </div>\r\n                                    <small id=\"emailHelp\" class=\"form-text text-muted\">Required a working email address.</small>\r\n                                </div>\r\n                            </form>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    <button type=\"button\" class=\"btn btn-primary btn-send-eadd\">Send</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    \r\n    <div class=\"modal modal-input-useremailaddress fade\" tabindex=\"-1\" role=\"dialog\" data-backdrop=\"static\">\r\n        <div class=\"modal-dialog modal-dialog-centered\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <h5 class=\"modal-title\">\r\n                        <i class=\"fa fa-info-circle\" style=\"font-size: 18px; color: #238ae6\"></i>&nbsp;\r\n                        <span data-i18n=\"\">Email address</span>\r\n                    </h5>\r\n                    <button type=\"button\" class=\"close btn-close-inputuseremail\" title=\"Close\" data-dismiss=\"modal\">\r\n                        <span aria-hidden=\"true\">&times;</span>\r\n                    </button>\r\n                </div>\r\n                <div class=\"modal-body pl-5 pr-5\">\r\n                    <div class=\"d-flex flex-column\">\r\n                        <div class=\"message\">\r\n                            <form class=\"form-input-email\">\r\n                                <div class=\"form-group\">\r\n                                    <label for=\"inputEmailAddress\">Input a valid email address for this account.</label>\r\n                                    <input type=\"email\" class=\"form-control\" id=\"inputEmailAddress\" aria-describedby=\"userEmailHelp\">\r\n                                    <div class=\"form-text text-danger text-left d-none\">\r\n                                        Invalid email address <i class=\"fas fa-exclamation\"></i>\r\n                                    </div>\r\n                                    <small id=\"userEmailHelp\" class=\"form-text text-muted\">Required a working email address.</small>\r\n                                </div>\r\n                            </form>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    <button type=\"button\" class=\"btn btn-primary btn-send-useremailadd\">Send</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"modal modal-email-verify-pin fade\" tabindex=\"-1\" role=\"dialog\" data-backdrop=\"static\">\r\n        <div class=\"modal-dialog modal-dialog-centered modal-md\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <h5 class=\"modal-title\">\r\n                        <i class=\"fa fa-info-circle\" style=\"font-size: 18px; color: #238ae6\"></i>&nbsp;\r\n                        <span data-i18n=\"common_lbl_enter_email_ver_pin\">Email Verification</span>\r\n                    </h5>\r\n                    <button type=\"button\" class=\"close btn-close-emailverifypin\" title=\"Close\" data-dismiss=\"modal\">\r\n                        <span aria-hidden=\"true\">&times;</span>\r\n                    </button>\r\n                </div>\r\n                <div class=\"modal-body\">\r\n                    <div class=\"d-flex align-items-center flex-column\">\r\n                        <div class=\"message\">\r\n                            <form class=\"form-input-emailpin text-center\">\r\n                                <div class=\"form-group\">\r\n                                    <div class=\"resent-emailpin-msg alert-success d-none\" data-i18n=\"common_lbl_ver_pin_success_sent\">Successfully sent a new verification pin.</div>\r\n                                    <br />\r\n                                    <span class=\"font-weight-normal pin-ea-text\"></span>\r\n                                    <br />\r\n                                    <span class=\"\" style=\"color: #007bff; cursor: pointer;\" onclick=\"showInputEmailAddressModal()\">\r\n                                        <span data-i18n=\"\">Having trouble accessing this email? Tap here!</span>\r\n                                        <br />\r\n                                    </span>\r\n                                    <br />\r\n                                    <input type=\"text\" maxlength=\"6\" autocomplete=\"off\" class=\"form-control text-center form-control-lg font-weight-bold\" id=\"inputPinCode\" aria-describedby=\"inputPinCodeHelp\" data-i18n=\"[placeholder]common_lbl_enter_6digitpin\" placeholder=\"Enter 6-digit PIN code\">\r\n                                    <div class=\"form-text text-danger text-center d-none\">\r\n                                        <span data-i18n=\"common_lbl_err_enter_ver_pin\">Input verification PIN code!</span>\r\n                                    </div>\r\n                                    <br />\r\n                                    <div>\r\n                                        <span data-i18n=\"common_lbl_didnt_receive_eamil\"></span>\r\n                                        <span id=\"countdownOTPExpiry\" style=\"font-weight:bold; font-style:italic; color:red\"></span>.<br /> \r\n                                    </div>\r\n                                    <div id=\"inputPinCodeHelp\"></div>\r\n                                </div>\r\n                            </form>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    <button type=\"button\" class=\"btn btn-secondary btn-resend-pin\" data-i18n=\"common_btn_resend\">Resend</button>&nbsp;&nbsp;&nbsp;\r\n                    <button type=\"button\" class=\"btn btn-primary btn-verify-pin\" data-i18n=\"common_btn_submit\">Submit</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"modal modal-error-verification-email fade\" tabindex=\"-1\" role=\"dialog\" data-backdrop=\"static\">\r\n        <div class=\"modal-dialog modal-dialog-centered\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <h5 class=\"modal-title\">\r\n                        <i class=\"fa fa-info-circle\" aria-hidden=\"true\" style=\"font-size: 18px; color: #238ae6\"></i>&nbsp;<span data-i18n=\"\">Message</span>\r\n                    </h5>\r\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\" title=\"Close\">\r\n                        <span aria-hidden=\"true\">&times;</span>\r\n                    </button>\r\n                </div>\r\n                <div class=\"modal-body\">\r\n                    <div class=\"d-flex align-items-center flex-column\">\r\n                        <i class=\"fa fa-exclamation-triangle\" style=\"font-size: 48px; color: #F6BE00\"></i>\r\n                        <br />\r\n                        <div class=\"err email-sent-failed d-none\">\r\n                            <span data-i18n=\"\">Email Verification PIN failed to send. Please try again later.</span><br />\r\n                        </div>\r\n                        <div class=\"err verify-pin-expired d-none\">\r\n                            <span data-i18n=\"\">PIN code provided has expired. Please resend a new PIN.</span><br />\r\n                        </div>\r\n                        <div class=\"err verify-pin-incorrect d-none\">\r\n                            <span data-i18n=\"\">Incorrect PIN code provided. Please try again.</span><br />\r\n                        </div>\r\n                        <div class=\"err verify-pin-failed d-none\">\r\n                            <span data-i18n=\"\">Our system is temporary unable to process your request. Please contact support or helpdesk.</span><br />\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    <button type=\"button\" class=\"btn btn-primary\" data-dismiss=\"modal\">OK</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    \r\n    <div class=\"modal modal-existing-eadd-verify-required fade\" tabindex=\"-1\" role=\"dialog\" data-backdrop=\"static\">\r\n        <div class=\"modal-dialog modal-dialog-centered\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <h5 class=\"modal-title\">\r\n                        <i class=\"fa fa-info-circle\" style=\"font-size: 18px; color: #238ae6\"></i>&nbsp;\r\n                        <span data-i18n=\"common_modal_email_verify_required\">Email Verification Required</span>\r\n                    </h5>\r\n                    <button type=\"button\" class=\"close btn-close-emailreqprompt\" title=\"Close\" data-dismiss=\"modal\">\r\n                        <span aria-hidden=\"true\">&times;</span>\r\n                    </button>\r\n                </div>\r\n                <div class=\"modal-body pl-5 pr-5\">\r\n                    <div class=\"d-flex flex-column\">\r\n                        <div class=\"message\">\r\n                            <p data-i18n=\"common_modal_email_verify_required_note\">Please verify your email address to ensure you receive important notifications and keep your account secured.</p>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    <button type=\"button\" class=\"btn btn-outline-secondary btn-verify-later\" data-dismiss=\"modal\" data-i18n=\"common_modal_btn_later\">Later</button>&nbsp;&nbsp;&nbsp;\r\n                    <button type=\"button\" class=\"btn btn-primary btn-verify-email\" data-i18n=\"common_modal_btn_verify_email\">Verify Email</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"modal modal-existing-email-verify-pin fade\" tabindex=\"-1\" role=\"dialog\" data-backdrop=\"static\">\r\n        <div class=\"modal-dialog modal-dialog-centered modal-md\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <h5 class=\"modal-title\">\r\n                        <i class=\"fa fa-info-circle\" style=\"font-size: 18px; color: #238ae6\"></i>&nbsp;\r\n                        <span data-i18n=\"common_lbl_enter_email_ver_pin\">Email Verification</span>\r\n                    </h5>\r\n                    <button type=\"button\" class=\"close btn-close-emailverifypinvea\" title=\"Close\" data-dismiss=\"modal\">\r\n                        <span aria-hidden=\"true\">&times;</span>\r\n                    </button>\r\n                </div>\r\n                <div class=\"modal-body\">\r\n                    <div class=\"d-flex align-items-center flex-column\">\r\n                        <div class=\"message\">\r\n                            <form class=\"form-input-emailpin text-center\">\r\n                                <div class=\"form-group\">\r\n                                    <div class=\"resent-emailpin-msg alert-success d-none\" data-i18n=\"common_lbl_ver_pin_success_sent\">Successfully sent a new verification PIN code.</div>\r\n                                    <br />\r\n                                    <span class=\"font-weight-normal pin-ea-text\"></span>\r\n                                    <br />\r\n                                    <span style=\"color: #007bff; cursor: pointer;\" onclick=\"showInputEAddModalExistingEmail()\">\r\n                                        <span data-i18n=\"common_modal_trouble_email_access_taphere\">Having trouble accessing this email? Tap here!</span>\r\n                                    </span>\r\n                                    <br /><br />\r\n                                    <input type=\"text\" maxlength=\"6\" autocomplete=\"off\" class=\"form-control text-center form-control-lg font-weight-bold\" id=\"inputPinCodeVerEAdd\" aria-describedby=\"inputPinCodeHelpVerEAdd\" data-i18n=\"[placeholder]common_lbl_enter_6digitpin\" placeholder=\"Enter 6-digit PIN code\">\r\n                                    <div class=\"form-text text-danger text-center d-none\">\r\n                                        <span data-i18n=\"common_lbl_err_enter_ver_pin\">Input verification pin!</span>\r\n                                    </div>\r\n                                    <br />\r\n                                    <div>\r\n                                        <span data-i18n=\"common_lbl_didnt_receive_eamil\"></span>\r\n                                        <span id=\"countdownOTPExpiryVerEAdd\" style=\"font-weight:bold; font-style:italic; color:red\"></span>.<br /> \r\n                                    </div>\r\n                                    <div id=\"inputPinCodeHelpVerEAdd\"></div>\r\n                                </div>\r\n                            </form>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    <button type=\"button\" class=\"btn btn-secondary btn-resend-pin-vea\" data-i18n=\"common_btn_resend\">Resend</button>&nbsp;&nbsp;&nbsp;\r\n                    <button type=\"button\" class=\"btn btn-primary btn-verify-pin-vea\" data-i18n=\"common_btn_submit\">Submit</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"modal modal-existing-input-useremail-pin fade\" tabindex=\"-1\" role=\"dialog\" data-backdrop=\"static\">\r\n        <div class=\"modal-dialog modal-dialog-centered\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <h5 class=\"modal-title\">\r\n                        <i class=\"fa fa-info-circle\" style=\"font-size: 18px; color: #238ae6\"></i>&nbsp;\r\n                        <span data-i18n=\"common_email_address\">Email address</span>\r\n                    </h5>\r\n                    <button type=\"button\" class=\"close btn-close-inputuseremailvea\" title=\"Close\" data-dismiss=\"modal\">\r\n                        <span aria-hidden=\"true\">&times;</span>\r\n                    </button>\r\n                </div>\r\n                <div class=\"modal-body pl-5 pr-5\">\r\n                    <div class=\"d-flex flex-column\">\r\n                        <div class=\"message\">\r\n                            <form class=\"form-input-email\">\r\n                                <div class=\"form-group\">\r\n                                    <label for=\"inputEmailPINVerEAdd\" data-i18n=\"common_modal_input_valid_eadd\">Input a valid email address for this account.</label>\r\n                                    <input type=\"email\" class=\"form-control\" id=\"inputEmailPINVerEAdd\" aria-describedby=\"emailHelpVerEAdd\">\r\n                                    <div class=\"form-text text-danger text-left d-none\">\r\n                                        <span data-i18n=\"common_modal_invalid_emailaddress\">Invalid email address</span> <i class=\"fas fa-exclamation\"></i>\r\n                                    </div>\r\n                                    <small id=\"emailHelpVerEAdd\" class=\"form-text text-muted\">\r\n                                        <span data-i18n=\"common_modal_req_working_emailaddress\">Required a working email address.</span>\r\n                                    </small>\r\n                                </div>\r\n                            </form>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    <button type=\"button\" class=\"btn btn-primary btn-send-eadd-vea\" data-i18n=\"common_modal_btn_send\">Send</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"modal modal-existing-error-verification-email fade\" tabindex=\"-1\" role=\"dialog\" data-backdrop=\"static\">\r\n        <div class=\"modal-dialog modal-dialog-centered\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <h5 class=\"modal-title\">\r\n                        <i class=\"fa fa-info-circle\" aria-hidden=\"true\" style=\"font-size: 18px; color: #238ae6\"></i>&nbsp;<span data-i18n=\"common_modal_message\">Message</span>\r\n                    </h5>\r\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\" title=\"Close\">\r\n                        <span aria-hidden=\"true\">&times;</span>\r\n                    </button>\r\n                </div>\r\n                <div class=\"modal-body\">\r\n                    <div class=\"d-flex align-items-center flex-column\">\r\n                        <i class=\"fa fa-exclamation-triangle\" style=\"font-size: 48px; color: #F6BE00\"></i>\r\n                        <br />\r\n                        <div class=\"err email-sent-failed d-none\">\r\n                            <span data-i18n=\"common_modal_error_email_failed\">Email Verification PIN failed to send. Please try again later.</span><br />\r\n                        </div>\r\n                        <div class=\"err verify-pin-expired d-none\">\r\n                            <span data-i18n=\"common_modal_error_pin_expired\">PIN provided has expired. Please resend a new PIN.</span><br />\r\n                        </div>\r\n                        <div class=\"err verify-pin-incorrect d-none\">\r\n                            <span data-i18n=\"common_modal_error_pin_incorrect\">Incorrect PIN provided. Please try again.</span><br />\r\n                        </div>\r\n                        <div class=\"err verify-pin-failed d-none\">\r\n                            <span data-i18n=\"common_modal_error_system_error\">Our system is temporary unable to process your request. Please contact support or helpdesk.</span><br />\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    <button type=\"button\" class=\"btn btn-primary\" data-dismiss=\"modal\" data-i18n=\"common_btn_ok\">OK</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"modal modal-existing-success-verification-email fade\" tabindex=\"-1\" role=\"dialog\" data-backdrop=\"static\">\r\n        <div class=\"modal-dialog modal-dialog-centered\" role=\"document\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <h5 class=\"modal-title\">\r\n                        <i class=\"fa fa-info-circle\" aria-hidden=\"true\" style=\"font-size: 18px; color: #238ae6\"></i>&nbsp;<span data-i18n=\"common_modal_message\">Message</span>\r\n                    </h5>\r\n                    <button type=\"button\" class=\"close\" data-dismiss=\"modal\" title=\"Close\">\r\n                        <span aria-hidden=\"true\">&times;</span>\r\n                    </button>\r\n                </div>\r\n                <div class=\"modal-body\">\r\n                    <div class=\"d-flex align-items-center flex-column\">\r\n                        <i class=\"fas fa-check\" style=\"font-size: 48px; color: #0BDA51\"></i>\r\n                        <br />\r\n                        <div class=\"email-verified\">\r\n                            <p data-i18n=\"common_modal_success_email_verification\">Email successfully verified.</p><br />\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"modal-footer\">\r\n                    <button type=\"button\" class=\"btn btn-primary\" data-dismiss=\"modal\" data-i18n=\"common_btn_close\">Close</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    \r\n\r\n</section>\r\n\r\n<script>\r\n    window.fwSettings = {\r\n        'widget_id': 29000000239\r\n    };\r\n\r\n    !function () {\r\n        if (\"function\" != typeof window.FreshworksWidget) {\r\n            var n = function () {\r\n                n.q.push(arguments)\r\n            };\r\n\r\n            n.q = [],\r\n                window.FreshworksWidget = n,\r\n                FreshworksWidget('hide', 'launcher');\r\n\r\n            FreshworksWidget('identify', 'ticketForm', {\r\n                name: 'Teacher Two',\r\n            });\r\n        }\r\n    }()\r\n</script>\r\n<!-- Freshworks Help Widget -->\r\n<script type='text/javascript' src='https://widget.freshworks.com/widgets/29000000239.js' async defer></script>\r\n<script>\r\n    // Configure Freshworks widget (runs after widget loads)\r\n    window.fwSettings = {\r\n        'widget_id': 29000000239\r\n    };\r\n\r\n    // Initialize when widget loads\r\n    function initFreshworksWidget() {\r\n        if (typeof window.FreshworksWidget === 'function') {\r\n            try {\r\n                FreshworksWidget('hide', 'launcher');\r\n                FreshworksWidget('identify', 'ticketForm', {\r\n                    name: 'Teacher Two'\r\n                });\r\n                //console.log('[Freshworks] Widget initialized');\r\n            } catch (e) {\r\n                console.error('[Freshworks] Initialization error:', e);\r\n            }\r\n        } else {\r\n            // Widget not loaded yet, try again\r\n            setTimeout(initFreshworksWidget, 100);\r\n        }\r\n    }\r\n\r\n    // Wait for widget to load\r\n    if (document.readyState === 'complete') {\r\n        initFreshworksWidget();\r\n    } else {\r\n        window.addEventListener('load', initFreshworksWidget);\r\n    }\r\n</script>\r\n\r\n<script type=\"text/javascript\">var bPop=false;\nvar strUserId=\"c0b03998-a787-45d7-9839-5f661b535760\";\n</script>\n\n<!-- PERFORMANCE OPTIMIZATION: Scripts moved to bundle -->\r\n<!-- AppHeader scripts loaded via ~/shared/bundles/appheader-js in AppLayout.Master -->\r\n<!-- This ensures jQuery is loaded BEFORE these scripts run -->\n\n<script type=\"text/javascript\">\n    var arrID = \"001554ca-0222-49e6-a808-fdb044182875\".split(\"|\");\n    var index = 0;\n    var serverData;\n    var submitData;\n    var newNotifications = \"0\";\n    var showAnnouncement = \"0\";\n    var isMOESLSSch = \"False\";\n    var hasTrueConsentFlag = \"True\".toLowerCase();\n    var pintimeout = 3;\n    var emailverified = \"\";\n    var usere