indow.self !== window.top) return;\r\n\r\n    if ($(\".modal.modal-external-link-message button.btn-primary\").length == 0) {\r\n        ForwardLink(linkHref, linkTarget);\r\n    }\r\n    else {\r\n        $(\".modal.modal-external-link-message a.target-link\").attr(\"href\", linkHref);\r\n        $(\".modal.modal-external-link-message a.target-link\").attr(\"target\", linkTarget);\r\n        $(\".modal.modal-external-link-message .modal-title\").html(i18next.t(\"common_modal_ext_link_title\"));\r\n        $(\".modal.modal-external-link-message .modal-body\").html(\"<p>\" + i18next.t(\"common_modal_ext_link_text\") + \"</p>\");\r\n        $(\".modal.modal-external-link-message\").modal(\"show\");\r\n\r\n        $(\".modal.modal-external-link-message button.btn-primary\").off(\"click\").on(\"click\", function (e) {\r\n            var modHref = $(\".modal.modal-external-link-message a.target-link\").attr('href');\r\n            var modTarget = $(\".modal.modal-external-link-message a.target-link\").attr('target');\r\n            ForwardLink(modHref, modTarget);\r\n        });\r\n    }\r\n}\r\n\r\n/**\r\n * Forwards to linkHref based on linkTarget\r\n * \r\n * @param {any} linkHref\r\n * @param {any} linkTarget\r\n */\r\nfunction ForwardLink(linkHref, linkTarget) {\r\n    if (linkTarget.toLowerCase() == \"_blank\") {\r\n        window.open(linkHref, linkTarget);\r\n    }\r\n    else if ($(\"#\" + linkTarget).length > 0) {\r\n        document.getElementById(linkTarget).src = linkHref;\r\n    }\r\n    else {\r\n        window.location.href = linkHref;\r\n    }\r\n};\r\n"
