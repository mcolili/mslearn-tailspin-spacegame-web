            "text": "@charset \"UTF-8\";\r\n\r\n/* Email Verification Modal Styles */\r\n.otp-container .otp-input {\r\n    width: 50px;\r\n    height: 50px;\r\n    font-size: 18px;\r\n    border-radius: 4px;\r\n}\r\n\r\n.otp-container .otp-input:focus {\r\n    border-color: #28a745;\r\n    box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);\r\n}\r\n\r\n.msie .app-container .app-content .article .article-content .article-sidebar.dialog {\r\n    top: 0 !important;\r\n}\r\n\r\nhtml {\r\n    font-size: 14px;\r\n}\r\n\r\nbody {\r\n    background-color: transparent;\r\n}\r\n\r\nimg {\r\n    max-width: 100%;\r\n    height: auto;\r\n}\r\n\r\na:focus {\r\n    box-shadow: none;\r\n    outline: 0;\r\n}\r\n\r\n.alert {\r\n    border: 0;\r\n    border-radius: 0;\r\n}\r\n\r\n.badge {\r\n    padding: 0.25rem 0.375rem;\r\n}\r\n\r\n    .badge.badge-primary {\r\n        background-color: #ff6600;\r\n    }\r\n\r\n    .badge.badge-light {\r\n        background-color: transparent;\r\n        color: #6c757d;\r\n    }\r\n\r\n.toast {\r\n    border-radius: 0;\r\n}\r\n\r\n    .toast .toast-header button.close {\r\n        outline: none;\r\n    }\r\n\r\n.btn {\r\n    border-radius: 0;\r\n}\r\n\r\n    .btn:not(:disabled):not(.disabled):hover, .btn:not(:disabled):not(.disabled):focus, .btn:not(:disabled):not(.disabled):active:focus {\r\n        box-shadow: none;\r\n    }\r\n\r\n    .btn.focus {\r\n        box-shadow: none;\r\n    }\r\n\r\n.btn-primary {\r\n    background-color: #7DAD00;\r\n    color: #ffffff;\r\n    margin: 0;\r\n    padding: 7px 23px;\r\n    text-align: center;\r\n    background-size: 200% auto;\r\n    border: 0;\r\n    border-radius: 20px !important;\r\n}\r\n\r\n    .btn-primary:disabled, .btn-primary.disabled, .btn-primary:disabled:hover, .btn-primary.disabled:hover {\r\n        background-color: #30c853;\r\n        border-color: #30c853;\r\n    }\r\n\r\n    .btn-primary:not(:disabled):not(.disabled):hover {\r\n        background-color: #4ca448;\r\n    }\r\n\r\n    .btn-prim