   }\r\n}\r\n\r\n/** tour css **/\r\n.intro-helper-number {\r\n    box-sizing: content-box;\r\n    position: absolute;\r\n    visibility: visible;\r\n    top: -16px;\r\n    left: -16px;\r\n    z-index: 9999999999 !important;\r\n    padding: 2px;\r\n    font-family: Arial, verdana, tahoma;\r\n    font-size: 13px;\r\n    font-weight: bold;\r\n    color: white;\r\n    text-align: center;\r\n    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.3);\r\n    background: #fda316;\r\n    /* Old browsers */\r\n    background: -webkit-linear-gradient(top, #fda316 0%, #ff6600 100%);\r\n    /* Chrome10+,Safari5.1+ */\r\n    background: -webkit-gradient(linear, left top, left bottom, color-stop(0%, #fda316), color-stop(100%, #ff6600));\r\n    /* Chrome,Safari4+ */\r\n    background: -moz-linear-gradient(top, #fda316 0%, #ff6600 100%);\r\n    /* FF3.6+ */\r\n    background: -ms-linear-gradient(top, #fda316 0%, #ff6600 100%);\r\n    /* IE10+ */\r\n    background: -o-linear-gradient(top, #fda316 0%, #ff6600 100%);\r\n    /* Opera 11.10+ */\r\n    background: linear-gradient(to bottom, #fda316 0%, #ff6600 100%);\r\n    /* W3C */\r\n    width: 20px;\r\n    height: 20px;\r\n    line-height: 20px;\r\n    border: 3px solid white;\r\n    border-radius: 50%;\r\n    filter: \"progid:DXImageTransform.Microsoft.gradient(startColorstr='#fda316', endColorstr='#ff6600', GradientType=0)\";\r\n    /* IE6-9 */\r\n    filter: \"progid:DXImageTransform.Microsoft.Shadow(direction=135, strength=2, color=ff0000)\";\r\n    /* IE10 text shadows */\r\n    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.4);\r\n}\r\n\r\n.custom-rp {\r\n    padding: 0;\r\n}\r\n\r\n    .custom-rp .introjs-tooltiptext {\r\n        padding: 20px;\r\n        padding-right: 40px;\r\n    }\r\n\r\n    .custom-rp .introjs-button {\r\n        font: inherit;\r\n        text-decoration: none;\r\n        background-image: none;\r\n        text-shadow: none;\r\n        border: 0;\r\n        padding: 0 2px;\r\n        text-align: center;\r\n        line-heig