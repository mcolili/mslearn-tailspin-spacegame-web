                           var pattern = \"YYYY-MM-DDTHH:mm:ss\";\r\n                            var date = moment(value, pattern, true);\r\n                            return formatDatetime(date, value, false);\r\n                        case \"DATEONLY\":\r\n                        case \"DATETIMEONLY\":\r\n                            var pattern = \"YYYY-MM-DDTHH:mm:ss\";\r\n                            var date = moment(value, pattern, true);\r\n                            return formatDatetime(date, value, true);\r\n                        case \"DTONLY\":\r\n                            var pattern = \"YYYY-MM-DDTHH:mm:ss\";\r\n                            var date = moment(value, pattern, true);\r\n                            return formatDatetime(date, value, true);\r\n                        default:\r\n                            return value;\r\n                    }\r\n                }\r\n            }\r\n        },\r\n        function (err, t) {\r\n            jqueryI18next.init(i18next, $, {\r\n                useOptionsAttr: true\r\n            });\r\n            if (options.initCallback) {\r\n                options.initCallback.call(null, err, t);\r\n            }\r\n        });\r\n    },\r\n    // PERFORMANCE OPTIMIZATION: Load TinyMCE on-demand before initializing\r\n    initTextEditor: async function (target, options) {\r\n        // Load TinyMCE if not already loaded\r\n        if (typeof DeferredLoader !== 'undefined') {\r\n            await DeferredLoader.loadTinyMCE();\r\n        }\r\n\r\n        options = options ? options : {};\r\n        options = $.extend({\r\n            images_upload_url: '/shared/upload',\r\n            image_uploadtab: true,\r\n            image_dimensions: false,\r\n            language: language.replace(\"-\", \"_\"),\r\n            //extended_valid_elements: \"script[src|async|defer|type|charset|id],span[data-mathml|tabindex|id|class|role|data-mce-style|style]\",\r\n            //language_url: '/static/tinymce/langs/id.js'\r\n        }, options);\r\n\r\n        if (tinymce.Env.desktop) {\r\n            // TinyMCE - add wrapper to scroll toolbar when user scrolls window.\r\n            if ($(target).closest('.texteditor').length === 0) {\r\n                window.editorCount = (window.editorCount !== undefined) ? ++window.editorCount : 0;\r\n                $(target).wrap('<div class=\"texteditor\" id=\"editor_' + window.editorCount + '\"></div>');\r\n                $(target).parent('.texteditor').append('<div class=\"texteditor-toolbar d-none\"></div>');\r\n            }\r\n            options = $.extend(options, {\r\n                fixed_toolbar_container: '.texteditor-toolbar'\r\n            });\r\n        } else {\r\n            options = $.extend(options, {\r\n                toolbar_drawer: 'sliding'\r\n            });\r\n        }\r\n        // HTML math editor\r\n        // Handling of MathML equation and rendering with MathJax.\r\n        var vMathJaxConfig = \"config=TeX-MML-AM_HTMLorMML\"; // +\"&delayStartupUntil=configured\";\r\n        var mathJaxUrl = \"/Lead/LEADUI/Scripts/MathJax-2.7.2/MathJax.js\" + \"?\" + vMathJaxConfig;\r\n        var mathJaxConfigUrl = \"/Lead/LEADUI/Scripts/questionbuilder/mathjax-config.js\";\r\n\r\n        tinymce.init($.extend(options, {\r\n            target: target,\r\n            min_height: 80,\r\n            max_height: 320,\r\n            autoresize_bottom_margin: 20,\r\n            inline: tinymce.Env.desktop,\r\n            menubar: false,\r\n            statusbar: false,\r\n            // plugins: ['autoresize', 'link', 'image', 'media', 'lists', 'table'],\r\n            plugins: ['autoresize', 'link', 'image', 'media', 'lists', 'table', 'autolink'],\r\n            toolbar: [\r\n                'undo redo',\r\n                'fontsizeselect fontselect styleselect',\r\n                'bold italic underline removeformat',\r\n                'forecolor backcolor',\r\n                'link image media',\r\n                'alig