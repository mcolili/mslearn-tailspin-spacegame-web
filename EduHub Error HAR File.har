e recovered once the action is completed.</li><li><span style=\\\"font - weight: bold; color: RED; \\\">REMOVE</span> this assignment from the students' assignment list.</li></ul>You may want to export out the students' marks/results for this assignment first before you proceed.<br/><br/>\",\r\n    common_unassign_agree_checkbox: \"I have read and accepted the terms mentioned above.\",\r\n\r\n    common_assignment_period: \"Assignment Period\",\r\n    common_edit_assignment: \"Edit Assignment\",\r\n    common_collaboration: \"Collaboration\",\r\n    common_social_learning_wall: \"Social Learning Wall\",\r\n    common_ubbu: \"Ubbu\",\r\n    common_hide_left_panel: \"Hide left panel\",\r\n    common_show_left_panel: \"Show left panel\",\r\n    common_modal_message: \"Message\",\r\n    common_format_date_days: \"{{dateValue, DAYS}}\",\r\n    common_label_months_ago: \" months ago\",\r\n    common_label_years_ago: \" years ago\",\r\n    common_label_imported: \"Imported\",\r\n    common_label_shared: \" Shared\",\r\n    common_label_student_details: \"Student Submission Details\",\r\n    common_richtext_insert_equation: \"Insert Math Equation\",\r\n    common_richtext_insert_equation_label_dialog_title: \"Dialog Title\",\r\n    common_richtext_insert_equation_btn_insert: \"Insert\",\r\n    common_richtext_insert_equation_text_click_image: \"Please click on image below to update\",\r\n    common_label_of: \"of\",\r\n    common_error_action: \"System is unable to perform the selected action. Please try again.\",\r\n    common_nothing_to_see_here: \"Oops, nothing to see here!\",\r\n    common_announcement: \"Announcement\",\r\n    common_label_percentage_completed: \"Percentage Completed\",\r\n    /*===============NEW 10.15.2019============*/\r\n    common_label_attachments: \"Attachments\",\r\n    common_msg_total_coins: \"You have <strong>{{totalCoins}}</strong> coins!\",\r\n    common_msg_first_login_award_coins: \"You are awarded <strong>{{coinsAwarded}}</strong> coins