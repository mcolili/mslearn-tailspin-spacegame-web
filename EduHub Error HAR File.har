            "text": "{\n  \"id\": 29000000239,\n  \"product_id\": null,\n  \"account_id\": 605685,\n  \"name\": \"Help Widget\",\n  \"settings\": {\"message\":\"MCEduHub Support\",\"button_text\":\"Help\",\"components\":{\"contact_form\":true,\"solution_articles\":true},\"contact_form\":{\"form_type\":2,\"form_title\":\"Report an Issue\",\"form_button_text\":\"Submit\",\"form_submit_message\":\"Thank you for your submission.\",\"attach_file\":true,\"screenshot\":true,\"captcha\":false,\"require_login\":false},\"appearance\":{\"position\":1,\"offset_from_right\":30,\"offset_from_left\":30,\"offset_from_bottom\":30,\"color_schema\":2,\"gradient\":4,\"pattern\":1,\"theme_color\":\"#e86f25\",\"button_color\":\"#45aaad\",\"theme_text_color\":\"#ffffff\",\"button_text_color\":\"#ffffff\",\"remove_freshworks_branding\":true},\"predictive_support\":{\"welcome_message\":\"Can we help?\",\"message\":\"We noticed you’re stuck. Tell us what you were trying to accomplish, and our support team will reach out to you as soon as possible.\",\"success_message\":\"Thanks. We'll be in touch!\"},\"widget_flow\":2},\n  \"active\": true,\n  \"created_at\": \"2023-03-30T05:28:58+02:00\",\n  \"updated_at\": \"2024-12-03T08:14:58+01:00\",\n  \"account_url\": \"https://mce.freshdesk.com\",\n  \"languages\": {\n    \"primary\": \"en\",\n    \"supported\": [\n      \"en\"\n    ]\n  },\n  \"date_format\": 1,\n  \"recaptcha_enterprise\": false,\n  \"enterprise_recaptcha_v2\": true\n}"
