        { title: 'Line spacing 2', inline: 'span', styles: { 'line-height': '2em' } },\r\n                { title: 'Line spacing 2.5', inline: 'span', styles: { 'line-height': '2.5em' } },\r\n                { title: 'Line spacing 3', inline: 'span', styles: { 'line-height': '3em' } }\r\n            ],\r\n            mobile: {\r\n                plugins: ['autoresize', 'link', 'image', 'lists', 'autolink'],\r\n                toolbar: [\r\n                    'undo', 'redo',\r\n                    'fontsizeselect fontselect',\r\n                    'bold', 'italic', 'underline',\r\n                    'forecolor',\r\n                    'link', 'image',\r\n                    'bullist', 'numlist'\r\n                ],\r\n                font_formats: 'Andale Mono=andale mono,times; Arial=arial,helvetica,sans-serif; Arial Black=arial black,avant garde; Book Antiqua=book antiqua,palatino; Comic Sans MS=comic sans ms,sans-serif; Courier New=courier new,courier; Georgia=georgia,palatino; Helvetica=helvetica; Impact=impact,chicago; Tahoma=tahoma,arial,helvetica,sans-serif; Terminal=terminal,monaco; Times New Roman=times new roman,times; Trebuchet MS=trebuchet ms,geneva; Verdana=verdana,geneva;楷体=KaiTi;',\r\n                fontsize_formats: \"8px 10px 12px 14px 18px 24px 36px 48px 72px\",\r\n            },\r\n            init_instance_callback: function (editor) {\r\n                editor.on('click', function (e) {\r\n                    window.Utils.removeAutoPlayAttrFromVideo();                    \r\n                });\r\n                editor.on('ExecCommand', function (e) {\r\n                    if (e.command === 'mceInsertContent') {\r\n                        window.Utils.removeAutoPlayAttrFromVideo();\r\n                    }\r\n                });\r\n                editor.on('focus', function (e) {\r\n                    if (tinymce.Env.desktop) {\r\n                        // TinyMCE - update toolbar position according to editable area.\r\n                        var texteditor = $(editor.contentAreaContainer).closest('.texteditor');\r\n                        var toolbar = $(texteditor).find('.texteditor-toolbar');\r\n                        $(toolbar).removeClass('d-none');\r\n                        $(toolbar).css('top', '-' + $(toolbar).height() + 'px');\r\n                    }\r\n                });\r\n\r\n                editor.on('blur', function (e) {\r\n                    if (tinymce.Env.desktop) {\r\n                        var texteditor = $(editor.contentAreaContainer).closest('.texteditor');\r\n                        var toolbar = $(texteditor).find('.texteditor-toolbar');\r\n                        $(toolbar).addClass('d-none');\r\n                    }\r\n                });\r\n\r\n                if (tinymce.Env.desktop) {\r\n                    if (editor.settings.fixed_toolbar_container === '.texteditor-toolbar') {\r\n                        var texteditor = $(editor.contentAreaContainer).closest('.texteditor');\r\n                        var container = '#' + $(texteditor).attr('id') + ' .texteditor-toolbar';\r\n                        editor.settings.fixed_toolbar_container = container; // console.log(container); 20220630\r\n                        //window.Utils.addMathJaxScript(editor, mathJaxUrl, mathJaxConfigUrl);//math editor\r\n                    }\r\n                    window.Utils.removeAutoPlayAttrFromVideo();\r\n                }\r\n\r\n                if (options.insertmeetb) {\r\n                    editor.ui.registry.addButton('insertmeetb', {\r\n                        text: '<image src=\"/Lead/LEADUI/Images/equation.gif\" style=\"height: 24px;width: 24px;padding: 3px 0px 0px 0px;\"/ >',\r\n                        tooltip: i18next.t(\"common_richtext_insert_equation\"),\r\n                        onAction: function() {\r\n                            var ids = window.Utils.getMEEIds();\r\n                            var qnId = $(\"#tests-questions button.btn-preview\").attr(\"testid\");\r\n                            //window.open(\"/Lead/MEE/insert_equation.aspx?from=testbank&resid=\" + \"{\" + qnId + \"}\" + \"&id=\" + ids, \"insert_equation\", \"width=800,height=500\");\r\n                            //window.open(\"/Lead/MEE/insert_htmlequation.aspx?from=testbank&resid=\" + \"{\" + qnId + \"}\" + \"&id=\" + ids, \"insert_equation\", \"width=\" + screen.width + \",height=\" + screen.height);\r\n                            popupCenter({ url: \"/Lead/MEE/insert_htmlequation.aspx?from=testbank&resid=\" + \"{\" + qnId + \"}\" + \"&id=\" + ids, title: 'insert_equation', w: 800, h: 500}); \r\n\r\n                        },\r\n                    });\r\n                }\r\n\r\n                if (options.insertmeetb_frac) {\r\n                    editor.ui.registry.addButton('insertmeetb_frac', {\r\n                        text: '<image src=\"/Lead/LEADUI/Images/fraction.png\" style=\"height: 24px;width: 24px;padding: 3px 0px 0px 0px;\"/ >',\r\n                        tooltip: i18next.t(\"common_richtext_insert_fraction\"),\r\n                        onAction: function () {\r\n                            window.Utils.resetImageStatus();\r\n\r\n                            var ids = window.Utils.getFracIds();\r\n                            var qnId = $(\"#tests-questions button.btn-preview\").attr(\"testid\");\r\n                            window.open(\"/Lead/TestBuilder/Fractions/insert_fraction.aspx?type=frac&from=testbank&resid=\" + qnId + \"&id=\" + ids, \"insert_fraction\", \"width=800,height=500\");\r\n\r\n                        },\r\n                    });\r\n                }\r\n\r\n                if (options.insertmeetb_mixfrac) {\r\n                    editor.ui.registry.addButton('insertmeetb_mixfrac', {\r\n                        text: '<image src=\"/Lead/LEADUI/Images/mixfraction.png\" style=\"height: 24px;width: 24px;padding: 3px 0px 0px 0px;\"/ >',\r\n                        tooltip: i18next.t(\"common_richtext_insert_mixfract